---
// 생성 과정의 단계별 방식 구분표(규칙 / QUBO 최적화 / 탐색 / 담금질 / 평가). 정의는 src/generate/pipeline.js 한곳.
import { badges, kindsTable, SELECT_STAGES, MODEL_STAGES, FREE_STAGES, QG_STAGES } from '../generate/pipeline.js';

interface Props {
  show?: 'select' | 'free' | 'both';
  legend?: boolean;
}
const { show = 'both', legend = true } = Astro.props;
const blocks = [
  ...(show !== 'free' ? [{ title: '선택형(도면 생성 탭)', rows: SELECT_STAGES, extra: MODEL_STAGES, extraTitle: '비교용 "기존: 모델 직접 탐색"을 고르면 위 3~5단계 대신' }] : []),
  ...(show === 'both' ? [{ title: 'QUBO 도면 생성(QUBO 도면 생성 탭): 규칙까지 모두 QUBO로', rows: QG_STAGES }] : []),
  ...(show !== 'select' ? [{ title: '자유형(자유형 평면 탭)', rows: FREE_STAGES }] : []),
];
---

<div class="pl-box">
  {legend && (
    <div class="pl-explain">
      <h4>다섯 가지 방식이란</h4>
      <p class="pl-sum">한마디로: <b>규칙</b>은 정해진 대로 바로 계산하고, <b>QUBO 최적화·담금질 최적화</b>는 에너지 식이 가장 낮은 답을 찾고, <b>탐색</b>은 조금씩 바꿔 보며 점수가 오르는 쪽으로 고쳐 가고, <b>평가</b>는 완성된 평면에 점수를 매겨 고릅니다. 이 가운데 QUBO 최적화·담금질 최적화·탐색만 "더 좋은 답을 찾는" 과정이고, 규칙과 평가는 답을 찾지 않습니다(규칙은 만들기만, 평가는 매기기만).</p>
      <Fragment set:html={kindsTable()} />
    </div>
  )}
  {blocks.map((b) => (
    <div class="pl-block">
      <h4>{b.title}</h4>
      <div class="mt-scroll">
        <table class="gen-table pl-table">
          <thead><tr><th>#</th><th>무엇을 정하나</th><th>방식</th><th>어떻게</th><th>코드</th></tr></thead>
          <tbody>
            {b.rows.map((r, i) => (
              <tr class={r.key ? 'pl-key' : ''}>
                <td class="mono">{i + 1}</td>
                <td>{r.what}</td>
                <td set:html={badges(r.kinds)} />
                <td>{r.how}</td>
                <td class="mono pl-code">{r.code}</td>
              </tr>
            ))}
            {b.extra && (
              <tr class="pl-extra"><td colspan="5">{b.extraTitle}: <Fragment set:html={badges(b.extra[0].kinds)} /> {b.extra[0].how} <span class="mono pl-code">({b.extra[0].code})</span></td></tr>
            )}
          </tbody>
        </table>
      </div>
    </div>
  ))}
</div>
