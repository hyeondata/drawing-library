---

interface Props {
  current: 'generate' | 'freeform' | 'how' | 'method' | 'code' | 'qubo' | 'easy' | 'qubogen';
}
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header class="topbar">
  <a class="brand" href={base}>
    <img src={`${base}favicon.svg`} alt="" width="28" height="28" />
    <span>평면 생성 랩</span>
  </a>
  <nav class="topnav" aria-label="주요 메뉴">
    <a href={base} aria-current={current === 'generate' ? 'page' : undefined}>도면 생성</a>
    <a href={`${base}qubo-gen/`} aria-current={current === 'qubogen' ? 'page' : undefined}>QUBO 도면 생성</a>
    <a href={`${base}freeform/`} aria-current={current === 'freeform' ? 'page' : undefined}>자유형 평면</a>
    <a href={`${base}how/`} aria-current={current === 'how' ? 'page' : undefined}>생성 원리</a>
    <a href={`${base}method/`} aria-current={current === 'method' ? 'page' : undefined}>방법과 근거</a>
    <a href={`${base}code/`} aria-current={current === 'code' ? 'page' : undefined}>코드로 보기</a>
    <a href={`${base}qubo-step/`} aria-current={current === 'qubo' ? 'page' : undefined}>QUBO 따라가기</a>
    <a href={`${base}easy/`} aria-current={current === 'easy' ? 'page' : undefined}>쉽게 보기</a>
  </nav>
</header>
