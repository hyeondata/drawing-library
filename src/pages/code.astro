---
// 코드로 보기: 알고리즘마다 실제 소스 코드(빌드 때 파일에서 함수를 그대로 잘라 옴)와 설명을 붙이고,
// 브라우저에서 같은 예시 입력으로 실제로 실행해 계산 과정을 보여 준다. 코드를 고치면 이 페이지도 같이 바뀐다.
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import fs from 'node:fs';
import path from 'node:path';
import { show } from '../lib/source.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const root = process.cwd();
const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);



const S = 'src/generate/solvers.js';
const Q = 'src/generate/qubo.js';
const F = 'src/freeform/engine.js';
const sections = [
  {
    id: 'qubo', title: '0. QUBO 만들기와 에너지', run: null,
    what: [
      '<b>buildQubo</b>: (실, 칸) 변수를 만들고, 항(TERMS)마다 단위 기여 φ를 모은 뒤 가중치를 곱해 대각(diag)·결합(M) 행렬에 더합니다. 마지막에 원-핫 벌점 P(Σx − 1)²을 펼쳐 대각 −P, 같은 묶음 쌍 +2P로 넣습니다.',
      '벌점 P = ⌈1 + 한 변수가 받는 목적 계수 절댓값 합의 최댓값⌉ — 이보다 작으면 제약을 어긴 해가 최적이 될 수 있습니다(Lucas 2014; Ayodele 2022).',
      '<b>energy</b>: E(x) = offset + Σ diag·x + Σ_{i<j} M_ij x_i x_j. <b>decode</b>: 해를 띠별 실 순서로 바꾸고, 원-핫을 어긴 해는 탐욕 복구합니다.',
    ],
    code: show(Q, 'buildQubo', 'energy', 'decode'),
  },
  {
    id: 'common', title: '1. 모든 풀이기의 공통 계산: Δ와 뒤집기', run: null,
    what: [
      '<b>deltas</b>: 변수 i를 뒤집을 때의 에너지 변화 Δ_i = (1 − 2x_i)(q_ii + Σ_j q_ij x_j)를 모든 변수에 대해 한 번 계산합니다(O(n²)).',
      '<b>flip</b>: i를 뒤집은 뒤 다른 변수의 Δ_j를 q_ij만큼만 고칩니다(O(n)). 그래서 한 걸음마다 에너지를 처음부터 다시 계산하지 않습니다.',
      '<b>tabu</b>: D²TS·PR·Memetic·Tabu가 함께 쓰는 핵심. 허용된 변수 가운데 Δ가 가장 작은 것을 뒤집고 tenure 동안 막습니다. 최고해보다 좋아지면 막혀 있어도 허용(aspiration), 개선 없이 alpha번이면 멈춥니다.',
    ],
    code: show(S, 'deltas', 'flip', 'tabu'),
  },
  { step: true, id: 'd2ts', title: '2. D²TS', run: 'd2ts', what: ['tabu로 깊이 내려간 뒤, 엘리트 해에서 <b>빈도(freq)와 난수로 순위를 매겨</b> 순위 j를 확률 ∝ j^−1.2로 γ = n/4개 뽑아 뒤집습니다(다양화). 다시 tabu → 반복(Glover, Lü & Hao 2010).'], code: show(S, 'd2ts') },
  { step: true, id: 'pr', title: '3. Path Relinking', run: 'pr', what: ['참조 집합 10개를 tabu로 만들고, 두 해 사이 다른 비트를 Δ가 작은 것부터 맞춰 가다 1/3~2/3 지점에서 tabu로 다듬어 참조 집합을 갱신합니다(Wang 외 2012).'], code: show(S, 'pathRelinking') },
  { step: true, id: 'memetic', title: '4. Memetic', run: 'memetic', what: ['개체 20개, 균등 교차(같은 비트는 유지, 다른 비트는 반반), 자식을 tabu로 다듬어 나쁜 개체와 바꿉니다(Lü, Glover & Hao 2010).'], code: show(S, 'memetic') },
  { step: true, id: 'tabu', title: '5. Tabu (D-Wave 방식)', run: 'tabu', what: ['tenure = min(20, ⌊n/4⌋), 읽기마다 무작위 해 또는 최고해에서 출발해 20ms씩 tabu(Palubeckis 2004 MST2).'], code: show(S, 'dwaveTabu') },
  {
    id: 'sa', title: '6. SA (QPU 임시 대체): 한 걸음씩 따라가기', run: 'sa', stepper: true,
    what: [
      '<b>변수는 동시에, 바꾸기는 하나씩.</b> 25개 변수 전체를 하나의 상태 x로 들고 다닙니다. 한 걸음에는 변수 하나만 뒤집어 볼지 정하지만, 그 판단(Δ)에 지금 켜져 있는 다른 변수들이 모두 들어가므로 25개가 서로 맞물려 함께 정해집니다.',
      '<b>한 sweep = 25개를 차례로 한 번씩.</b> 이것을 1,000번(= 25,000걸음) 하는 동안 온도를 뜨겁게(β₀ = ln2/최대 변화량)에서 차갑게(β₁ = ln100/최소 계수)로 낮춥니다. 끝났을 때의 x 전체가 답입니다.',
      '<b>받아들이기 규칙</b>: Δ ≤ 0이면 무조건 뒤집고, Δ > 0(오르막)이면 확률 e^(−βΔ)로만 뒤집습니다(Kirkpatrick 외 1983). 아래 "한 걸음씩"에서 실제 숫자로 볼 수 있습니다.',
      '<b>아래 첫 번째 코드</b>는 같은 계산을 풀어 쓰고 줄마다 설명을 단 설명용 코드(sa-explained.js)이고, <b>두 번째</b>는 사이트가 실제로 쓰는 압축된 코드(solvers.js)입니다. 같은 시드면 결과가 똑같습니다(테스트로 확인). 양자 어닐링 결과가 아닙니다.',
    ],
    code: show('src/generate/sa-explained.js', 'createSA') + show(S, 'betaRange', 'sa'),
  },
  { step: true, id: 'pt', title: '7. Parallel Tempering', run: 'pt', what: ['β 사다리 8개 사본을 각자 메트로폴리스로 돌리고, 이웃 사본을 확률 min(1, e^((β_k−β_{k+1})(E_k−E_{k+1})))로 교환합니다(Hukushima & Nemoto 1996).'], code: show(S, 'parallelTempering') },
  { step: true, id: 'sqa', title: '8. SQA (경로적분 양자 몬테카를로)', run: 'sqa', what: ['QUBO → 이징(J = M/4, h = q_ii/2 + ΣM/4), Trotter 사본 16개를 B = −½ ln tanh(Γ/PT)로 묶고 Γ를 2.5 → 0.01로 줄입니다(Santoro 외 2002). 고전 컴퓨터의 대리입니다.'], code: show(S, 'sqa') },
  { step: true, id: 'sb', title: '9. Simulated Bifurcation (dSB)', run: 'sb', what: ['스핀을 위치 x·운동량 y로 바꿔 y += (−(1−a)x + c₀ΣK sgn(x))Δt, x += yΔt, |x| > 1이면 벽. a를 0 → 1로 올린 뒤 sgn(x)를 해로 읽습니다(Goto 외 2021). 일차 항은 +1 보조 스핀.'], code: show(S, 'simulatedBifurcation') },
  { step: true, id: 'cpsat', title: '10. CP-SAT 방식(분기한정)', run: 'cpsat', what: ['칸을 차례로 채우며 실마다 한 번만(AllDifferent), 하한 = 지금 에너지 + 남은 칸의 최소 기여 + 남은 칸 쌍의 음수 결합. 하한 ≥ 최고해면 가지를 자릅니다.'], code: show(S, 'cpBranchAndBound') },
  { step: true, id: 'exact', title: '11. 전수 열거(전역 최적해)', run: 'exact', what: ['원-핫을 지키는 모든 배정(앞 m! × 뒤 k!)을 계산합니다. 벌점이 유효하므로 QUBO 전역 최적해 = 다른 풀이기의 정답지.'], code: show(S, 'exact') },
  {
    step: true, stepKey: 'model', id: 'model', title: '11-1. 기존: 모델 직접 탐색(QUBO 없이)', run: null,
    what: ['QUBO를 거치지 않고, 평면 변수(깊이 D·앞 띠 비율 f·작은방 폭 w·안방 깊이 g·실 순서 등)를 무작위로 뽑아 평면을 만들고 목적함수 J로 채점합니다(무작위 탐색). 그다음 좋은 안 몇 개에서 변수를 조금씩 바꿔 더 좋아지면 옮겨 갑니다(국소 탐색). 이 방식은 모든 변수를 매번 함께 정해 평면 하나를 통째로 평가합니다.'],
    code: show('src/generate/optimize.js', 'optimize'),
  },
  { id: 'runner', title: '12. 같은 조건으로 돌리는 틀: runSolver', run: null, what: ['모든 풀이기에 같은 시간(또는 평가 횟수) 예산과 시드를 주고, 최저 에너지가 바뀔 때마다 [경과 ms, 평가 횟수, 에너지, 해]를 trace에 남깁니다. 이 페이지의 "실행" 표가 이 trace입니다(Dunning 외 2018의 같은 예산 비교).'], code: show(S, 'runSolver') },
  { id: 'size', title: '13. 방 크기 계산: 폭 나누기와 다듬기', run: null, what: ['<b>allocate</b>: 최소 폭을 먼저 주고 남는 폭을 (원하는 폭 − 최소 폭)에 비례해 나눕니다. 띠 폭이 최소 폭 합보다 좁으면 최소 폭에 비례해 모두 줄입니다(이때 좁은 실 감점).', '<b>realize</b>: QUBO가 정한 순서로 평면을 만들고, 깊이·앞 띠 비율·작은방 폭·안방 깊이를 30번 조금씩 바꿔 목적함수 J가 가장 높은 것을 고릅니다.'], code: show('src/generate/layout.js', 'allocate') + show('src/generate/compare.js', 'realize') },
  { id: 'ff-init', title: '14. 자유형: 제약 성장(처음 배치)', run: null, what: ['씨앗을 원래 위치에서 jitter만큼 옮겨 놓고(공용 실은 덜), 모자란 실부터 직사각형으로 한 줄씩 → 막히면 줄 일부로 ㄱ자 성장 → 남은 칸은 가장 많이 맞닿은 이웃에(Lopes 외 2010).'], code: show(F, 'initial') },
  { id: 'ff-energy', title: '15. 자유형: 에너지와 공간구문', run: null, what: ['<b>energy</b>: 면적·둘레·꼭짓점·좁은 부분·인접·창·접근·침실 통과(·현관·외곽·공간구문) 항을 무게와 곱해 더합니다.', '<b>syntaxOf</b>: 평가 모델과 같은 정의로 통합도(1/RRA)·깊이를 계산하고 거실/침실 비·τ·공·사 깊이 차를 냅니다.'], code: show(F, 'energy', 'syntaxOf', 'syntaxPenalty') },
  { step: true, stepKey: 'freeform', id: 'ff-anneal', title: '16. 자유형: 담금질(벽 밀기)', run: 'freeform', what: ['80%는 맞닿은 벽 한 줄을 통째로 한 칸 미는 이동, 20%는 칸 하나. 실이 쪼개지면 되돌리고, 바뀐 실만 다시 세어 ΔE를 구한 뒤 ΔE ≤ 0이면 받아들이고 아니면 확률 e^(−ΔE/T). 온도 1.5 → 0.005(Kirkpatrick 외 1983).'], code: show(F, 'anneal') },
];
---

<Base title="코드로 보기 · 평면 생성 랩" description="알고리즘마다 실제 소스 코드와 주석, 설명을 보여 주고 브라우저에서 같은 예시로 실행해 계산 과정을 확인합니다.">
  <Topbar current="code" />

  <section class="hero hero-compact">
    <p class="eyebrow">실제 코드 · 주석 · 실행</p>
    <h1>코드로 <span class="gradient-text">보기</span></h1>
    <p class="lede">알고리즘마다 <b>사이트가 실제로 쓰는 코드</b>를 그대로 보여 줍니다(빌드할 때 소스 파일에서 함수를 잘라 오므로, 코드가 바뀌면 이 페이지도 같이 바뀝니다). 알고리즘마다 <b>"한 걸음씩 따라가기"</b>가 있습니다: 실제 풀이기 코드에 넣어 둔 기록점이 걸음마다 남긴 값(어느 변수를 왜 뒤집었는지, Δ, 확률, 하한 등)을 쉬운 문장과 실 × 칸 표로 보여 줍니다. 기록점은 계산을 바꾸지 않습니다(기록 있음/없음 결과가 같음을 테스트로 확인). 또 각 코드 아래 "실행"을 누르면 같은 예시 입력(84㎡ · 침실 3 · 욕실 2 · 드레스룸, 보정 가중치 QUBO)으로 브라우저에서 실제로 돌려, 에너지가 좋아질 때마다의 값을 표로 보여 줍니다. 식의 유도와 근거는 <a href={`${base}method/`}>방법과 근거</a>, 전체 흐름은 <a href={`${base}how/`}>생성 원리</a>에 있습니다.</p>
  </section>

  <main class="mt">
    <nav class="mt-toc" aria-label="목차">
      <ol>{sections.map((s) => <li><a href={`#${s.id}`}>{s.title.replace(/^\d+\.\s*/, '')}</a></li>)}</ol>
    </nav>
    <section class="mt-sec" id="cd-input">
      <h2>예시 입력</h2>
      <div id="cd-qinfo" class="note">QUBO를 만드는 중…</div>
    </section>
    {sections.map((s) => (
      <section class="mt-sec" id={s.id}>
        <h2>{s.title}</h2>
        <ul class="cd-what">{s.what.map((w) => <li set:html={w} />)}</ul>
        {s.stepper && (
          <div class="sa-step" id="sa-stepper">
            <h3>한 걸음씩 실행해 보기</h3>
            <div class="sa-ctl">
              <button type="button" class="button-primary small" data-sa="1">한 걸음</button>
              <button type="button" class="button-ghost small" data-sa="sweep">한 sweep(변수 전체 한 바퀴)</button>
              <button type="button" class="button-ghost small" data-sa="100">100 sweep</button>
              <button type="button" class="button-ghost small" data-sa="end">끝까지(1,000 sweep)</button>
              <button type="button" class="button-ghost small" data-sa="reset">처음부터</button>
              <label>시드 <input type="number" id="sa-seed" value="1" min="1" max="999" /></label>
            </div>
            <div class="sa-grid">
              <div id="sa-matrix"></div>
              <div id="sa-info"></div>
            </div>
            <div id="sa-chart"></div>
            <div id="sa-log"></div>
          </div>
        )}
        <details class="cd-code" open={s.id === 'common' || s.id === 'd2ts' || s.id === 'sa'}>
          <summary>실제 코드 보기</summary>
          <Fragment set:html={s.code} />
        </details>
        {s.step && (
          <div class="st-box sa-step" data-st={s.stepKey || s.run}>
            <h3>한 걸음씩 따라가기(실제 코드의 기록)</h3>
            <div class="sa-ctl">
              <button type="button" class="button-primary small" data-step="rec">▶ 실행하고 기록</button>
              <button type="button" class="button-ghost small" data-step="first">⏮</button>
              <button type="button" class="button-ghost small" data-step="-1">◀ 이전</button>
              <button type="button" class="button-ghost small" data-step="1">다음 ▶</button>
              <button type="button" class="button-ghost small" data-step="10">+10</button>
              <button type="button" class="button-ghost small" data-step="100">+100</button>
              <button type="button" class="button-ghost small" data-step="last">⏭</button>
              {['d2ts', 'pr', 'memetic', 'tabu', 'cpsat'].includes(s.run) && <button type="button" class="button-ghost small" data-step="special">다음 주요 단계 ⤳</button>}
              <label>시드 <input type="number" value="1" min="1" max="999" data-seed /></label>
              {(s.stepKey || s.run) === 'freeform' ? <label>이동 수 <select data-steps><option value="1500">1,500</option><option value="3000" selected>3,000</option></select></label> : (s.stepKey !== 'model' && <label>평가 예산 <select data-budget><option value="5000">5,000</option><option value="30000" selected>30,000</option></select></label>)}
            </div>
            <input type="range" min="0" max="0" value="0" data-slider class="gen-time-slider" aria-label="기록 위치" />
            <div data-view><p class="note">"실행하고 기록"을 누르면 실제 코드를 같은 예시로 돌리면서 걸음마다 기록을 남기고, 여기서 한 걸음씩 볼 수 있습니다. 표의 칸 = 변수(실 × 칸), 초록 테두리 = 방금 뒤집은 변수, 점선 = 섭동으로 고른 변수.</p></div>
          </div>
        )}
        {s.run && (
          <div class="cd-run" data-run={s.run}>
            <div class="cd-run-ctl">
              <button type="button" class="button-primary small" data-go={s.run}>▶ 이 예시로 실행</button>
              <label>평가 횟수 예산 <select data-budget><option value="2000">2,000</option><option value="20000">20,000</option><option value="100000" selected>100,000</option><option value="500000">500,000</option></select></label>
              <span class="note">평가 1회 = 변수 하나를 뒤집어 보는 시도 1번. SA의 담금질 한 번 = 1,000 sweep × 변수 수 = 25,000회.</span>
              <label>시드 <input type="number" value="1" min="1" max="999" data-seed /></label>
            </div>
            <div class="cd-out" data-out></div>
          </div>
        )}
      </section>
    ))}
  </main>

  <footer class="footer">
    <span>평면 생성 랩 · 코드로 보기</span>
    <span>코드는 빌드 때 소스에서 그대로 가져옴</span>
  </footer>
  <script id="cd-data" type="application/json" set:html={JSON.stringify({ base })} />
  <script>
    import '../scripts/code.js';
  </script>
</Base>
