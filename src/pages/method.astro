    for (const p of pp) pts.push({ x: p[wk], y: p.J, group: String(k), shape: TPL_STYLE[k]?.shape, hollow: p.pen, ring: Math.abs(p[wk] - minE) < 1e-9, label: `앞 침실 ${k + 1}개 · ${p.order} · 에너지 ${p[wk].toFixed(2)} · J ${p.J.toFixed(1)}${p.pen ? ' · 기본 치수에서 좁은 실·문 동선 문제' : ''}` });
