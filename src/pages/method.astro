---
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import catalog from '../../public/data/catalog.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const doc = 'https://github.com/hyeondata/drawing-library/blob/main/evidence/11-%EA%B3%84%EC%82%B0-%EC%9B%90%EB%A6%AC.md';
const samples = catalog.filter((d) => d.kind === 'SPA').slice(0, 8).map((d) => d.id);
---

<Base title="계산 원리 · 평면 평가 랩" description="축척 보정, 공간구문, 점수 환산, 종합 점수, QUBO 풀이, 가중치 보정을 값을 바꿔 가며 직접 확인하는 시각화.">
  <Topbar current="method" />

  <section class="hero hero-compact">
    <p class="eyebrow">식 → 값 → 점수</p>
    <h1>계산 <span class="gradient-text">원리</span></h1>
    <p class="lede">
      평가 모델과 도면 생성이 쓰는 식을 값을 바꿔 가며 직접 확인할 수 있습니다. 모든 그림은 이 사이트의 평가 코드를 브라우저에서 그대로 돌린 결과입니다.
      식의 근거와 전체 설명은 <a href={doc} target="_blank" rel="noopener">evidence/11-계산-원리.md</a>에 있습니다.
    </p>
  </section>

  <main class="mth" id="mth">
    <nav class="mth-toc" aria-label="목차">
      <a href="#f-scale">1 축척 보정</a>
      <a href="#f-syntax">2 공간구문</a>
      <a href="#f-score">3 점수 환산</a>
      <a href="#f-total">4 종합 점수</a>
      <a href="#f-qubo">5 QUBO 풀이</a>
      <a href="#f-calib">6 가중치 보정</a>
    </nav>

    <!-- 1 -->
    <section class="mth-fig" id="f-scale">
      <header>
        <p class="mth-num">1 · 입력 정규화</p>
        <h2>침실 크기를 자로 삼아 기준값을 늘이고 줄입니다</h2>
        <p>도면마다 같은 1px가 다른 길이라(침실 한 변 160~487px), 침실 한 변의 중앙값으로 배율 s를 구하고 길이·면적 기준값에 곱합니다. 벽 간격은 선 굵기라 그대로 둡니다.</p>
      </header>
      <div class="mth-formula">s = clip( 침실 한 변 중앙값 ÷ 305, 0.4, 2.5 )</div>
      <div class="mth-controls">
        <label class="mth-range">침실 한 변 중앙값 <output id="scale-out">305</output>px
          <input type="range" id="scale-in" min="150" max="520" step="1" value="305" />
        </label>
        <p class="mth-big">s = <b id="scale-s">1.00</b></p>
      </div>
      <figure class="mth-chart" id="scale-chart" aria-label="기준값 배수 막대"></figure>
      <details class="mth-table"><summary>표로 보기</summary><div id="scale-table"></div></details>
    </section>

    <!-- 2 -->
    <section class="mth-fig" id="f-syntax">
      <header>
        <p class="mth-num">2 · 공간구문</p>
        <h2>실을 누르면 깊이에서 통합도까지 차례로 계산합니다</h2>
        <p>실끼리 벽을 맞대면 링크(인접 그래프)입니다. 누른 실에서 다른 실까지의 단계 수(깊이)로 평균깊이 → RA → RRA → 통합도를 구합니다. 덕트는 빼고, 현관에는 세대 밖 노드를 붙입니다.</p>
      </header>
      <div class="mth-formula">MD = Σd ÷ (K−1) &nbsp;·&nbsp; RA = 2(MD−1) ÷ (K−2) &nbsp;·&nbsp; RRA = RA ÷ D<sub>K</sub> &nbsp;·&nbsp; 통합도 = 1 ÷ RRA</div>
      <div class="mth-controls">
        <label class="mth-select">도면
          <select id="syn-drawing">{samples.map((id) => <option value={id}>{id.replace('APT_FP_SPA_', 'SPA ')}</option>)}</select>
        </label>
        <label class="mth-select">세대 <select id="syn-unit"></select></label>
      </div>
      <div class="mth-split">
        <figure class="mth-chart mth-plan" id="syn-chart" aria-label="인접 그래프와 깊이"></figure>
        <div class="mth-steps" id="syn-steps" aria-live="polite"></div>
      </div>
      <ul class="mth-legend" id="syn-legend"></ul>
    </section>

    <!-- 3 -->
    <section class="mth-fig" id="f-score">
      <header>
        <p class="mth-num">3 · 점수 환산</p>
        <h2>기준 35세대 분포에서 얼마나 벗어났는지가 점수입니다</h2>
        <p>지표 값 x를 기준 분포의 중앙값과 강건 척도 Qn으로 z로 바꾸고, |z| = 3이면 0점이 되도록 선형으로 깎습니다. 값이 몇 개뿐인 지표는 백분위로 채점합니다. 방향이 정해진 지표는 좋은 쪽으로 벗어나면 100점입니다.</p>
      </header>
      <div class="mth-formula" id="score-formula">z = (x − 중앙값) ÷ Qn &nbsp;·&nbsp; 점수 = 100 · max(0, 1 − |z| ÷ 3)</div>
      <div class="mth-controls">
        <label class="mth-select">지표 <select id="score-feature"></select></label>
        <label class="mth-range">평가할 값 x <output id="score-x-out"></output>
          <input type="range" id="score-x" min="0" max="1" step="0.001" />
        </label>
        <p class="mth-big">z = <b id="score-z">–</b> · 점수 <b id="score-v">–</b></p>
      </div>
      <figure class="mth-chart" id="score-chart" aria-label="기준 분포와 점수 곡선"></figure>
      <details class="mth-table"><summary>표로 보기</summary><div id="score-table"></div></details>
    </section>

    <!-- 4 -->
    <section class="mth-fig" id="f-total">
      <header>
        <p class="mth-num">4 · 종합 점수</p>
        <h2>영역 점수에 가중치를 곱해 더합니다</h2>
        <p>2번에서 고른 세대의 영역 점수입니다. 가중치(기본 30·20·10·10·30)를 바꾸면 종합 점수와 등급이 바뀝니다. 관문 규칙(필수 실·연결·침실 비통과)을 어기면 '유효하지 않음'으로 따로 표시하고, 단일 점수가 필요하면 69점을 상한으로 겁니다.</p>
      </header>
      <div class="mth-formula">종합 = Σ (가중치<sub>영역</sub> × 점수<sub>영역</sub>) ÷ Σ 가중치</div>
      <div class="mth-controls mth-weights" id="total-weights"></div>
      <p class="mth-big">종합 <b id="total-score">–</b> · 등급 <b id="total-grade">–</b> <span id="total-valid" class="note"></span></p>
      <figure class="mth-chart" id="total-chart" aria-label="영역별 기여"></figure>
      <details class="mth-table"><summary>표로 보기</summary><div id="total-table"></div></details>
    </section>

    <!-- 5 -->
    <section class="mth-fig" id="f-qubo">
      <header>
        <p class="mth-num">5 · QUBO 풀이</p>
        <h2>풀이기마다 최적 에너지에 얼마나 빨리 닿는지 봅니다</h2>
        <p>84㎡·방 3개의 실 배치 QUBO를 풀이기마다 같은 시간(0.3초) 동안 풀고, 그때까지 찾은 가장 낮은 에너지와 전수 열거로 구한 최적값의 차를 시간에 따라 그립니다. 0에 닿으면 최적입니다.</p>
      </header>
      <div class="mth-formula">E(x) = Σ<sub>t</sub> w<sub>t</sub>·φ<sub>t</sub>(x) + P·Σ<sub>묶음</sub>(Σx − 1)² &nbsp;·&nbsp; 뒤집기 변화 Δ<sub>i</sub> = (1−2x<sub>i</sub>)(q<sub>ii</sub> + Σ<sub>j</sub> q<sub>ij</sub>x<sub>j</sub>)</div>
      <div class="mth-controls">
        <label class="mth-select">시드 <input type="number" id="qubo-seed" value="1" min="1" max="999" /></label>
        <button type="button" class="button-primary small" id="qubo-run">풀이기 돌리기</button>
        <p class="note" id="qubo-info" aria-live="polite"></p>
      </div>
      <figure class="mth-chart" id="qubo-chart" aria-label="시간에 따른 최적 에너지와의 차"></figure>
      <ul class="mth-legend" id="qubo-legend"></ul>
      <details class="mth-table"><summary>표로 보기</summary><div id="qubo-table"></div></details>
    </section>

    <!-- 6 -->
    <section class="mth-fig" id="f-calib">
      <header>
        <p class="mth-num">6 · 가중치 보정</p>
        <h2>에너지가 가장 낮은 배치가 좋은 평면이 되도록 가중치를 맞췄습니다</h2>
        <p>한 조건의 가능한 배치를 모두 평면으로 풀어 순위 점수를 쟀습니다. 점 하나가 배치 하나입니다. QUBO를 정확히 풀면 가장 왼쪽(에너지 최소) 점이 나오므로, 그 점이 위쪽(높은 점수)에 있을수록 좋습니다. 위아래 차이가 '후회'입니다. 이 그림의 점수는 깊이·폭을 다듬기 전(기본 치수)이라 실제 생성 결과보다 낮고, 아래쪽(−45 근처) 점들은 좁은 실·문 동선 감점을 받은 배치입니다.</p>
      </header>
      <div class="mth-formula">후회 = 점수(에너지 최소 배치) − 그 조건의 최고 점수 &nbsp;·&nbsp; E = Σ w<sub>t</sub>·φ<sub>t</sub> 이라 가중치에 선형</div>
      <div class="mth-controls">
        <div class="seg" role="group" aria-label="가중치">
          <button type="button" data-w="hand" aria-pressed="false">손으로 정한 가중치</button>
          <button type="button" data-w="calibrated" aria-pressed="true">보정한 가중치</button>
        </div>
        <p class="mth-big" id="calib-stat"></p>
      </div>
      <figure class="mth-chart" id="calib-scatter" aria-label="에너지와 순위 점수"></figure>
      <h3 class="mth-sub">항별 가중치: 손 대 보정</h3>
      <figure class="mth-chart" id="calib-bars" aria-label="항별 가중치"></figure>
      <ul class="mth-legend" id="calib-legend"></ul>
      <details class="mth-table"><summary>표로 보기</summary><div id="calib-table"></div></details>
    </section>
  </main>

  <div class="mth-tip" id="mth-tip" role="tooltip" hidden></div>

  <footer class="footer">
    <span>평면 평가 랩 · 계산 원리</span>
    <span>모든 그림은 평가 코드를 브라우저에서 그대로 돌린 결과입니다</span>
  </footer>

  <script id="mth-data" type="application/json" set:html={JSON.stringify({ base })} />
  <script>
    import '../scripts/method.js';
  </script>
</Base>
