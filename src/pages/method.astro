---
// 방법과 근거: 생성 식, QUBO 정식화, 풀이기별 알고리즘, 자유형 에너지. 표·가중치·예시 QUBO는 빌드 때 실제 코드로 계산한다.
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import Pipeline from '../components/Pipeline.astro';
import { TERMS, buildQubo, decode } from '../generate/qubo.js';
import { runSolver } from '../generate/solvers.js';
