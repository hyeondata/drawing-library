---
// 방법과 근거: 생성 식, QUBO 정식화, 풀이기별 알고리즘, 자유형 에너지. 표·가중치·예시 QUBO는 빌드 때 실제 코드로 계산한다.
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import { TERMS, buildQubo, decode } from '../generate/qubo.js';
import { CALIBRATED } from '../generate/qubo-weights.js';
import { runSolver } from '../generate/solvers.js';
import { programOf } from '../generate/layout.js';
import { WEIGHTS, FREEDOM, MIN_WIDTH, CELL } from '../freeform/engine.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// ---- 예시 QUBO: 84㎡, 침실 3, 욕실 2, 드레스룸, 선호 없음 ----
const spec = {
  area: 84,
  bedrooms: 3,
  baths: 2,
  dress: true,
  multi: false,
  outdoorUnit: false,
  balcony: true,
  targets: { living: 0.24, kitchen: 0.12, master: 0.15, other: 0.11, bath: 0.05, entrance: 0.04, dress: 0.04, multi: 0.04 },
  prefs: [],
};
const q = buildQubo(spec, { weights: 'calibrated' });
const nameOf = Object.fromEntries(programOf(spec).map((r) => [r.key, r.name]));
const ex = runSolver('exact', q, { seed: 1, budgetMs: 3000 });
const bestX = ex.samples[0].x;
const order = decode(q, bestX);
const nGroups = q.groups.length;
// 목적 항만의 행렬과 벌점 항만의 행렬
const n = q.n;
const obj = Array.from({ length: n }, () => new Float64Array(n));
for (const t of q.terms) {
  const w = q.weights[t.id] ?? 0;
  const u = q.unit[t.id];
  for (const [i, v] of u.lin) obj[i][i] += w * v;
  for (const [key, v] of u.quad) {
    const a = Math.floor(key / n);
    const b = key % n;
    obj[a][b] += w * v;
    obj[b][a] += w * v;
  }
}
const full = (i, j) => (i === j ? q.diag[i] : q.M[i * n + j]);
const pen = (i, j) => full(i, j) - obj[i][j];
const heat = (f, title, clip) => {
  const S = 13;
  const L = 96;
  const T = 30;
  const cells = [];
  const col = (v) => {
    const t = Math.max(-1, Math.min(1, v / clip));
    if (Math.abs(t) < 1e-9) return 'var(--surface-2)';
    // 발산형: 음수(보상) 파랑, 양수(벌점·감점) 주황
    return t < 0 ? `rgba(42,120,214,${(0.15 + 0.85 * -t).toFixed(3)})` : `rgba(232,89,12,${(0.15 + 0.85 * t).toFixed(3)})`;
  };
  for (let i = 0; i < n; i++)
    for (let j = 0; j < n; j++) {
      const v = f(i, j);
      cells.push(`<rect x="${L + j * S}" y="${T + i * S}" width="${S - 1}" height="${S - 1}" fill="${col(v)}"><title>${q.vars[i].room}@${q.vars[i].band}${q.vars[i].slot} × ${q.vars[j].room}@${q.vars[j].band}${q.vars[j].slot}: ${v.toFixed(2)}</title></rect>`);
    }
  const labels = q.vars.map((v, i) => `<text x="${L - 4}" y="${T + i * S + 10}" text-anchor="end" class="mt-ax">${nameOf[v.room] ?? v.room}·${v.band === 'front' ? '앞' : '뒤'}${v.slot + 1}</text>`).join('');
  return `<svg viewBox="0 0 ${L + n * S + 4} ${T + n * S + 4}" role="img" aria-label="${title}"><text x="${L}" y="18" class="mt-ax mt-ttl">${title}</text>${labels}${cells.join('')}</svg>`;
};
let objMax = 0;
for (let i = 0; i < n; i++) for (let j = 0; j < n; j++) objMax = Math.max(objMax, Math.abs(obj[i][j]));
const heatObj = heat((i, j) => obj[i][j], '목적 항 Σ wₜφₜ (가중치 × 단위 기여)', objMax);
const heatPen = heat(pen, `원-핫 벌점 P(Σx − 1)² (P = ${q.penalty})`, q.penalty * 2);

// ---- 항 표 ----
const shape = {
  kitchenLiving: '이차·앞뒤 맞닿음', entranceLiving: '이차·앞뒤 맞닿음', entranceKitchen: '이차·옆 칸', bathKitchen: '이차·옆 칸', bathEntrance: '이차·옆 칸', bathLiving: '이차·앞뒤 맞닿음', multiKitchen: '이차·옆 칸',
  bedEntrance: '이차·앞뒤 맞닿음', backBedEntrance: '이차·옆 칸', backBedUnderBed: '이차·앞뒤 맞닿음', backBedKitchen: '이차·옆 칸', bedLiving: '이차·옆 칸', bedBed: '이차·옆 칸',
  livingOffCenter: '일차·위치', masterNotEnd: '일차·위치', entranceEnd: '일차·위치', kitchenEnd: '일차·위치', backBedEnd: '일차·위치', masterKitchen: '이차·앞뒤 맞닿음', bedOverBath: '이차·앞뒤 맞닿음',
};
const termRows = TERMS.map((t) => ({ ...t, shape: shape[t.id] || '', cal: CALIBRATED.weights[t.id] }));
const cv = CALIBRATED.meta.cv;

// ---- 문헌 ----
const R = {
  lucas: { t: 'Lucas 2014, Ising formulations of many NP problems, Front. Phys.', u: 'https://doi.org/10.3389/fphy.2014.00005' },
  glover19: { t: 'Glover, Kochenberger & Du 2019, QUBO 튜토리얼, 4OR', u: 'https://doi.org/10.1007/s10288-019-00424-y' },
  ayodele: { t: 'Ayodele 2022, Penalty weights in QUBO formulations: permutation problems, EvoCOP', u: 'https://arxiv.org/abs/2206.11040' },
  jin: { t: 'Jin 2011, Surrogate-assisted evolutionary computation, Swarm Evol. Comput.', u: 'https://doi.org/10.1016/j.swevo.2011.05.001' },
  d2ts: { t: 'Glover, Lü & Hao 2010, Diversification-driven tabu search for UBQP, 4OR', u: 'https://doi.org/10.1007/s10288-009-0115-y' },
  pr: { t: 'Wang, Lü, Glover & Hao 2012, Path relinking for UBQP, EJOR', u: 'https://doi.org/10.1016/j.ejor.2012.07.012' },
  hma: { t: 'Lü, Glover & Hao 2010, A hybrid metaheuristic approach to solving the UBQP problem, EJOR', u: 'https://doi.org/10.1016/j.ejor.2010.06.039' },
  palu: { t: 'Palubeckis 2004, Multistart tabu search strategies for UBQP, Ann. Oper. Res.', u: 'https://doi.org/10.1023/B:ANOR.0000039522.58036.68' },
  kirk: { t: 'Kirkpatrick, Gelatt & Vecchi 1983, Optimization by simulated annealing, Science', u: 'https://doi.org/10.1126/science.220.4598.671' },
  isakov: { t: 'Isakov et al. 2015, Optimised simulated annealing for Ising spin glasses, CPC', u: 'https://doi.org/10.1016/j.cpc.2015.02.015' },
  hn: { t: 'Hukushima & Nemoto 1996, Exchange Monte Carlo method, J. Phys. Soc. Jpn.', u: 'https://doi.org/10.1143/JPSJ.65.1604' },
  goto19: { t: 'Goto, Tatsumura & Dixon 2019, Simulating adiabatic bifurcations, Sci. Adv.', u: 'https://doi.org/10.1126/sciadv.aav2372' },
  goto21: { t: 'Goto et al. 2021, High-performance combinatorial optimization based on classical mechanics, Sci. Adv.', u: 'https://doi.org/10.1126/sciadv.abe7953' },
  santoro: { t: 'Santoro, Martoňák, Tosatti & Car 2002, Theory of quantum annealing of an Ising spin glass, Science', u: 'https://doi.org/10.1126/science.1068774' },
  martonak: { t: 'Martoňák, Santoro & Tosatti 2002, Quantum annealing by the path-integral Monte Carlo method, PRB', u: 'https://doi.org/10.1103/PhysRevB.66.094203' },
  bucher: { t: 'Bucher et al. 2024, Towards robust benchmarking of quantum optimization algorithms', u: 'https://arxiv.org/abs/2405.07624' },
  dunning: { t: 'Dunning, Gupta & Silberholz 2018, What works best when? Max-Cut·QUBO 휴리스틱 평가, INFORMS JoC', u: 'https://doi.org/10.1287/ijoc.2017.0798' },
  ronnow: { t: 'Rønnow et al. 2014, Defining and detecting quantum speedup, Science', u: 'https://doi.org/10.1126/science.1252319' },
  derrac: { t: 'Derrac et al. 2011, 비모수 검정 튜토리얼, Swarm Evol. Comput.', u: 'https://doi.org/10.1016/j.swevo.2011.02.002' },
  merrell: { t: 'Merrell, Schkufza & Koltun 2010, Computer-generated residential building layouts, ACM TOG', u: 'https://doi.org/10.1145/1882261.1866203' },
  michalek: { t: 'Michalek, Choudhary & Papalambros 2002, Architectural layout design optimization, Eng. Optim.', u: 'https://doi.org/10.1080/03052150214016' },
  lopes: { t: 'Lopes, Tutenel, Smelik, de Kraker & Bidarra 2010, A constrained growth method for procedural floor plan generation, GAME-ON', u: 'https://publications.graphics.tudelft.nl/papers/584' },
  hussin: { t: 'Hussin & Stützle 2014, Tabu search vs. simulated annealing for QAP, Comput. Oper. Res.', u: 'https://doi.org/10.1016/j.cor.2013.10.007' },
};
const cite = (ids) => ids.map((id) => R[id]);

// ---- 풀이기 ----
// 결과: evidence/10-QUBO-생성.md (30시드 × 4조건, 풀이기당 100ms를 평가 횟수로 고정, 보정 가중치)
const solvers = [
  {
    key: 'model', name: '기존: 모델 직접 탐색', family: '평가 모델을 바로 최적화(QUBO 아님)',
    idea: 'QUBO를 거치지 않고, 판상형 매개변수(깊이·앞 띠 비율·실 순서·폭 등)를 바꿔 가며 목적함수 J를 직접 키웁니다. 기준선 역할을 합니다.',
    steps: ['매개변수를 무작위로 400번 뽑아 평면을 만들고 J로 채점합니다.', '상위 4안에서 출발해 매개변수 하나를 조금 바꾸는 국소 탐색을 400번 합니다(나빠지면 되돌림).', '배치가 서로 다른 상위 3안을 보여 줍니다.'],
    params: '평가 800회(무작위 400 + 국소 400)', refs: ['michalek', 'merrell'],
    result: '모델 점수 86.2, 순위 점수 87.2(가장 높음). 연속값까지 800번 평가로 맞추기 때문입니다.',
  },
