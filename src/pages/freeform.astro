---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import { WEIGHTS, FREEDOM, MIN_WIDTH, CELL, SYNTAX_GOAL, FIXED } from '../freeform/engine.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const units = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public', 'data', 'shapes.json'), 'utf8'));
const drawings = new Set(units.map((u) => u.drawing)).size;
const W = WEIGHTS;
const door = Math.ceil(0.9 / CELL);
const terms = [
  ['면적', W.area, 'Σ<sub>r</sub> ((n<sub>r</sub> − t<sub>r</sub>) / t<sub>r</sub>)²', '목표 칸 수에서 벗어난 비율의 제곱. 큰 실·작은 실을 같은 무게로 봅니다(칸이 하나도 없는 실은 10).'],
  ['둘레', 'w<sub>P</sub>', 'Σ<sub>r</sub> (둘레<sub>r</sub> / (4√n<sub>r</sub>) − 1)', '같은 칸 수의 정사각형보다 둘레가 긴 만큼. 구불구불한 실을 막습니다.'],
  ['꼭짓점', W.corner, 'Σ<sub>r</sub> max(0, 꼭짓점<sub>r</sub> − K)', '모양 자유도의 상한 K(아래 표)를 넘은 꼭짓점 수. 사각형은 4, ㄱ자는 6, ㄷ자는 8개입니다.'],
  ['좁은 부분', W.thin, 'Σ<sub>r</sub> 좁은 칸<sub>r</sub> / n<sub>r</sub>', `가로·세로로 이어진 길이가 모두 최소 폭(${Object.entries(MIN_WIDTH).map(([k, v]) => `${k} ${v}`).join(', ')}m)보다 짧은 칸의 비율.`],
  ['창', W.window, 'Σ<sub>r∈거실·침실</sub> max(0, 2.0 − 바깥 벽 길이<sub>r</sub>)', '거실·침실이 바깥(발코니 포함)에 2.0m 이상 닿지 않은 만큼(m).'],
  ['인접', W.adj, 'Σ<sub>(p,q)∈필요 쌍</sub> [맞닿은 길이(p, q) &lt; 문 폭]', `기준 세대에서 문이 필요했던 실 쌍(공용 실과 닿는 쌍, 드레스룸·화장실–침실)이 문 폭 0.9m(${door}칸)만큼 맞닿지 않으면 1.`],
  ['접근', W.access, '현관에서 갈 수 없는 실의 수', '문 폭 이상 맞닿은 실을 따라 현관에서 출발해 닿을 수 없는 실.'],
  ['침실 통과', W.through, '침실을 지나야만 갈 수 있는 실의 수', '공용 실에 닿지 않아 침실을 거쳐야 하는 실.'],
  ['현관', W.entry, '[현관이 바깥에 닿은 길이 &lt; 문 폭]', '외곽을 바꿨을 때만. 현관문이 복도 쪽 바깥에 나야 합니다.'],
  ['외곽', W.outline, 'max(0, 외곽 꼭짓점 − K<sub>외곽</sub>)', '외곽도 다듬을 때만. 지나치게 들쭉날쭉한 외곽을 막습니다.'],
  ['공간구문', '4 (강하게 10)', `거실 중심: max(0, ${SYNTAX_GOAL.lbr} − 거실/침실 통합도 비)/${SYNTAX_GOAL.lbr} + (1 − τ)/2<br>사생활: max(0, ${SYNTAX_GOAL.gap} − 공·사 깊이 차)/${SYNTAX_GOAL.gap}<br>대면형 주방: max(0, ${SYNTAX_GOAL.kbr} − 주방/침실 통합도 비)/${SYNTAX_GOAL.kbr}`, '공간구문 선호를 고른 경우만. 통합도·깊이는 평가 모델과 같은 정의로 매번 정확히 계산합니다.'],
];
---

<Base title="자유형 평면 · 평면 생성 랩" description="AI 허브 Sample에서 사각형이 아닌 실(ㄱ자 거실 등)이 있는 세대를 골라, 그 외곽과 실 구성을 바탕으로 새 평면을 만들고 계산 과정을 보여 줍니다.">
  <Topbar current="freeform" />

  <section class="hero hero-compact">
    <p class="eyebrow">Sample 세대 → 격자 배정 → 담금질</p>
    <h1>자유형 <span class="gradient-text">평면 생성</span></h1>
    <p class="lede">
      AI 허브 Sample {drawings}장에서 뽑은, 사각형이 아닌 실(ㄱ자 거실·주방 등)이 있는 {units.length}세대 중 하나를 고르세요.
      그 세대의 외곽과 현관·발코니 위치, 실 구성과 연결 관계를 그대로 두고 안쪽을 다시 나눠, ㄱ자·ㄷ자 실까지 나올 수 있는 새 평면을 만듭니다.
    </p>
  </section>


  <section class="ff-algo" aria-labelledby="ff-algo-h">
    <details open>
      <summary><h2 id="ff-algo-h">어떻게 푸나: 알고리즘과 수식</h2></summary>
      <p class="ff-algo-lead"><b>한 줄 요약.</b> 세대를 {CELL}m 칸으로 나누고, <b>칸마다 어느 실인지</b>를 정하는 문제로 풉니다. ① <b>제약 성장</b>으로 처음 배치를 만들고, ② <b>담금질(Simulated Annealing)</b>로 아래 에너지 E를 줄입니다. 도면 생성 탭과 달리 QUBO를 쓰지 않습니다. ㄱ자·ㄷ자 실이 되려면 "실을 이루는 칸들이 서로 이어져 있어야 한다"는 조건이 필요한데, 이 연결 조건은 QUBO의 이차식으로 쓰기 어렵기 때문입니다.</p>

      <h3>1. 해(답)의 모양</h3>
      <div class="mt-eq">a : 칸 c → 실 번호 a(c) ∈ {'{'}1, …, R{'}'} &nbsp;(외곽도 다듬으면 바깥 −1 포함),&nbsp;&nbsp; n<sub>r</sub> = |{'{'}c : a(c) = r{'}'}|,&nbsp;&nbsp; t<sub>r</sub> = 목표 칸 수</div>
      <p>목표 칸 수 t<sub>r</sub>는 기준 세대에서 그 실이 차지한 비율 × 움직일 수 있는 칸 수입니다. {[...FIXED].join('·')}과 1.5㎡ 미만의 작은 실은 제자리에 고정하고, 나머지 실의 칸만 바꿉니다. <b>조건</b>: 실마다 칸이 한 덩어리로 이어져 있어야 합니다(이 조건을 깨는 이동은 하지 않음).</p>

      <h3>2. 처음 배치: 제약 성장 (Lopes 외 2010)</h3>
      <ol>
        <li>실마다 씨앗 칸을 기준 세대의 원래 위치 근처에 놓습니다(무작위로 조금 옮김, 공용 실은 덜 옮김).</li>
        <li>n<sub>r</sub> / t<sub>r</sub>가 가장 작은(가장 모자란) 실부터, <b>직사각형을 유지하며</b> 한 줄씩 넓힙니다.</li>
        <li>더 넓힐 수 없으면 줄의 일부만 넓혀 <b>ㄱ자로</b> 자랍니다.</li>
        <li>끝까지 남은 칸은 가장 많이 맞닿은 실에 줍니다.</li>
      </ol>

      <h3>3. 에너지: 낮을수록 좋은 평면</h3>
      <div class="mt-eq">E(a) = Σ<sub>k</sub> w<sub>k</sub> · T<sub>k</sub>(a)</div>
      <div class="mt-scroll">
        <table class="gen-table ff-algo-tbl">
          <thead><tr><th>항 T<sub>k</sub></th><th>무게 w<sub>k</sub></th><th>식</th><th>뜻</th></tr></thead>
          <tbody>{terms.map(([n, w, f, d]) => <tr><td>{n}</td><td class="mono" set:html={String(w)} /><td set:html={f} /><td set:html={d} /></tr>)}</tbody>
        </table>
      </div>
      <div class="mt-scroll">
        <table class="gen-table ff-algo-tbl">
          <thead><tr><th>모양 자유도</th><th>실 꼭짓점 상한 K</th><th>둘레 무게 w<sub>P</sub></th><th>외곽 꼭짓점 상한 K<sub>외곽</sub></th></tr></thead>
          <tbody>{Object.values(FREEDOM).map((f) => <tr><td>{f.label}</td><td class="mono">{f.K}</td><td class="mono">{f.compact}</td><td class="mono">{f.Kout}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">꼭짓점은 2×2 칸 창을 훑으며 셉니다(창 안에서 그 실 칸이 1개나 3개면 꼭짓점 1개, 대각선 2개면 2개). 무게는 "접근 불가(10)"처럼 꼭 지켜야 할 것을 크게, "침실 통과(1.5)"처럼 피하면 좋은 것을 작게 잡았습니다.</p>

      <h3>4. 담금질 (Kirkpatrick 외 1983)</h3>
      <div class="mt-eq">T<sub>s</sub> = T<sub>0</sub> · (T<sub>1</sub> / T<sub>0</sub>)<sup>s / N</sup> &nbsp;(T<sub>0</sub> = 1.5, T<sub>1</sub> = 0.005),&nbsp;&nbsp; 받아들일 확률 p = min(1, e<sup>−ΔE / T<sub>s</sub></sup>)</div>
      <ol>
        <li><b>이동 하나 제안</b>(N번 반복, N = 화면의 이동 수):
          <ul>
            <li>80%: <b>벽 밀기</b> — 두 실이 맞닿은 벽 한 줄을 통째로 한 칸 밉니다. 직사각형을 유지한 채 크기만 바뀝니다.</li>
            <li>20%: <b>칸 넘기기</b> — 칸 하나를 이웃 실로 넘깁니다.</li>
            <li>외곽도 다듬으면 이동의 25%는 바깥 벽 칸을 떼거나 바깥 칸을 붙입니다(발코니에 붙은 벽은 그대로, 갇힌 구멍은 만들지 않음).</li>
          </ul>
        </li>
        <li>실이 둘로 쪼개지면 바로 되돌립니다.</li>
        <li>바뀐 실(과 맞닿은 실)만 다시 세어 <b>ΔE = E(새 배치) − E(지금 배치)</b>를 구합니다.</li>
        <li>ΔE ≤ 0이면 받아들이고, ΔE &gt; 0이면 확률 e<sup>−ΔE/T</sup>로만 받아들입니다. 처음(T가 클 때)은 나빠지는 이동도 가끔 받아들여 갇히지 않고, 끝(T가 작을 때)은 좋아지는 이동만 남습니다.</li>
        <li>지금까지 E가 가장 낮았던 배치를 답으로 냅니다.</li>
      </ol>
      <p class="note">벽 밀기를 주로 쓰는 이유: 칸 하나만 옮기면 거의 매번 꼭짓점이 2개 늘어 E가 올라갑니다(실측: 이동 282개 중 좋아지는 것 10개). "후보 개수"만큼 시드를 바꿔 따로 풀어 여러 안을 보여 줍니다. 실제 코드와 걸음별 ΔE·온도·확률은 <a href={`${base}code/#ff-anneal`}>코드로 보기 14~16</a>, 근거는 <a href={`${base}method/#freeform`}>방법과 근거 7절</a>에 있습니다.</p>
    </details>
  </section>

  <main class="ff" id="ff">
    <section class="ff-step" aria-labelledby="ff-h1">
      <div class="ff-head">
        <h2 id="ff-h1"><span class="gen-num">1</span> 기준 세대 고르기</h2>
        <div class="seg ff-filter" role="group" aria-label="거르기" id="ff-filter">
          <button type="button" data-f="all" aria-pressed="true">전체</button>
          <button type="button" data-f="거실" aria-pressed="false">ㄱ자 거실</button>
          <button type="button" data-f="주방" aria-pressed="false">비정형 주방</button>
          <button type="button" data-f="침실" aria-pressed="false">비정형 침실</button>
          <button type="button" data-f="many" aria-pressed="false">비정형 3실 이상</button>
        </div>
      </div>
      <p class="note">주황 테두리가 사각형이 아닌 실(면적이 외접 사각형의 85% 미만)입니다. 면적은 침실 크기로 추정한 값이라, 다음 단계에서 원하는 전용면적으로 맞출 수 있습니다.</p>
      <div class="ff-gallery" id="ff-gallery"></div>
    </section>

    <section class="ff-step" aria-labelledby="ff-h2" id="ff-setup" hidden>
      <h2 id="ff-h2"><span class="gen-num">2</span> 조건 정하기</h2>
      <div class="ff-setup">
        <figure class="gen-plan" id="ff-orig"></figure>
        <div class="ff-controls">
          <div class="ff-orig-info" id="ff-orig-info"></div>
          <div class="ff-field">
            <span>세대 외곽</span>
            <div class="seg ff-wrap" role="group" id="ff-omode">
              <button type="button" data-v="orig" aria-pressed="true">원본 그대로</button>
              <button type="button" data-v="tf" aria-pressed="false">원본 변형</button>
              <button type="button" data-v="tpl" aria-pressed="false">모양 고르기</button>
              <button type="button" data-v="draw" aria-pressed="false">직접 그리기</button>
            </div>
          </div>
          <div class="ff-sub" id="ff-o-tf" hidden>
            <div class="ff-row">
              <button type="button" class="button-ghost small" id="ff-rot">↻ 90° 회전</button>
              <button type="button" class="button-ghost small" id="ff-fx">⇆ 좌우 뒤집기</button>
              <button type="button" class="button-ghost small" id="ff-fy">⇅ 상하 뒤집기</button>
            </div>
            <label class="ff-field">가로세로 비율 <b class="mono" id="ff-asp-v">1.00</b>
              <input type="range" id="ff-asp" min="0.6" max="1.6" step="0.05" value="1" />
              <span class="note">면적은 그대로 두고 가로를 늘리면 세로가 줄어듭니다. 원본 실 배치·현관·발코니도 함께 변형됩니다.</span>
            </label>
          </div>
          <div class="ff-sub" id="ff-o-tpl" hidden>
            <div class="seg ff-wrap" role="group" id="ff-tpl">
              <button type="button" data-v="rect" aria-pressed="false">직사각형</button>
              <button type="button" data-v="L" aria-pressed="true">ㄱ자</button>
              <button type="button" data-v="U" aria-pressed="false">ㄷ자(홈)</button>
              <button type="button" data-v="T" aria-pressed="false">凸자</button>
              <button type="button" data-v="step" aria-pressed="false">엇갈림</button>
            </div>
            <label class="ff-field">가로세로 비율 <b class="mono" id="ff-taspect-v">1.50</b><input type="range" id="ff-taspect" min="1" max="2.4" step="0.05" value="1.5" /></label>
            <label class="ff-field">꺾임 크기 <b class="mono" id="ff-tcut-v">0.35</b><input type="range" id="ff-tcut" min="0.15" max="0.5" step="0.01" value="0.35" /></label>
          </div>
          <div class="ff-sub" id="ff-o-draw" hidden>
            <p class="note">왼쪽 격자(한 칸 0.6m)를 누르거나 끌어서 칠하고, 칠한 칸에서 시작하면 지웁니다. 아래쪽이 앞(발코니 쪽)입니다.</p>
            <div class="ff-row">
              <button type="button" class="button-ghost small" id="ff-dload">원본 외곽 불러오기</button>
              <button type="button" class="button-ghost small" id="ff-dclear">모두 지우기</button>
              <span class="mono" id="ff-darea"></span>
            </div>
          </div>
          <div class="ff-sub" id="ff-o-out" hidden>
            <div class="ff-field">
              <span>발코니 둘 면 <span class="note">(여러 개 고를 수 있음)</span></span>
              <div class="seg ff-wrap" role="group" id="ff-bsides">
                <button type="button" data-v="S" aria-pressed="true">앞(아래)</button>
                <button type="button" data-v="N" aria-pressed="false">뒤(위)</button>
                <button type="button" data-v="W" aria-pressed="false">왼쪽</button>
                <button type="button" data-v="E" aria-pressed="false">오른쪽</button>
              </div>
              <span class="note">고른 면마다 가장 바깥 외벽 중 2.4m 이상 이어진 구간을 따라 1.5m 깊이로 둡니다. 거실·침실이 닿으면 발코니 문을 냅니다.</span>
            </div>
            <label class="ff-check"><input type="checkbox" id="ff-outunit" /> 실외기실(첫 발코니 끝)</label>
          </div>
          <label class="ff-check"><input type="checkbox" id="ff-ofree" /> 외곽도 함께 다듬기 <span class="note">— 담금질이 바깥 벽 칸도 붙이고 뗍니다(외곽 꼭짓점 벌점)</span></label>
          <label class="ff-field" id="ff-area-wrap">전용면적(㎡) <input type="number" id="ff-area" min="40" max="200" step="1" /></label>
          <div class="ff-field">
            <span>모양 자유도</span>
            <div class="seg" role="group" id="ff-freedom">
              <button type="button" data-v="rect" aria-pressed="false">직사각형 위주</button>
              <button type="button" data-v="L" aria-pressed="true">ㄱ자까지</button>
              <button type="button" data-v="free" aria-pressed="false">ㄷ자·자유형</button>
            </div>
            <span class="note">실 하나의 꼭짓점 상한(4·6·8개)과 둘레 벌점 무게가 바뀝니다.</span>
          </div>
          <div class="ff-field">
            <span>공간구문 선호 <span class="note">(여러 개, 고르면 에너지에 더함)</span></span>
            <div class="seg ff-wrap" role="group" id="ff-sx">
              <button type="button" data-v="livingCentral" aria-pressed="false">거실 중심형</button>
              <button type="button" data-v="privacy" aria-pressed="false">사생활</button>
              <button type="button" data-v="kitchenLink" aria-pressed="false">대면형 주방</button>
            </div>
            <label class="ff-check">세기 <select id="ff-sxw"><option value="4" selected>보통</option><option value="10">강하게</option></select></label>
            <span class="note">평가 모델과 같은 공간구문 정의(통합도 = 1/RRA, 현관 기준 깊이)로 매 이동마다 계산해, 문헌 목표(거실/침실 통합도 비 1.9, 공·사 깊이 차 1.5, 주방/침실 비 1.3)에 못 미친 만큼 벌점을 줍니다.</span>
          </div>
          <label class="ff-field">변화 정도 <b class="mono" id="ff-jitter-v">0.5</b>
            <input type="range" id="ff-jitter" min="0" max="1" step="0.05" value="0.5" />
            <span class="note">0이면 원본 배치를 그대로 다듬고, 1에 가까울수록 실의 씨앗을 멀리 옮겨 새로 키웁니다.</span>
          </label>
          <div class="ff-row">
            <label class="ff-field">계산량
              <select id="ff-steps">
                <option value="12000">빠르게(1.2만 번)</option>
                <option value="30000" selected>보통(3만 번)</option>
                <option value="70000">꼼꼼히(7만 번)</option>
              </select>
            </label>
            <label class="ff-field">후보 수
              <select id="ff-count">
                <option value="1">1</option>
                <option value="3" selected>3</option>
                <option value="4">4</option>
              </select>
            </label>
            <label class="ff-field">시드 <input type="number" id="ff-seed" value="1" min="1" max="9999" /></label>
          </div>
          <button type="button" class="button-primary" id="ff-run">이 세대를 바탕으로 생성</button>
          <div class="gen-progress" id="ff-progress" hidden>
            <div class="gen-bar"><i id="ff-bar"></i></div>
            <p class="note" id="ff-progress-text"></p>
          </div>
        </div>
      </div>
    </section>

    <section class="ff-step" aria-labelledby="ff-h3" id="ff-result" hidden>
      <div class="ff-head">
        <h2 id="ff-h3"><span class="gen-num">3</span> 생성 결과</h2>
        <div class="seg gen-tabs" role="tablist" id="ff-tabs"></div>
        <div class="seg" role="group" id="ff-view">
          <button type="button" data-v="full" aria-pressed="true">모든 요소</button>
          <button type="button" data-v="space" aria-pressed="false">실만</button>
        </div>
      </div>
      <div class="gen-diag-orient" id="ff-orient">
        <span>앞쪽(도면 아래, 발코니 쪽)이 바라보는 방위</span>
        <div class="seg ff-wrap" role="group" id="ff-dir"></div>
        <label>각도 <input type="number" id="ff-az" min="0" max="359" step="1" value="180" />°</label>
        <label>위도 <input type="number" id="ff-lat" min="33" max="39" step="0.01" value="37.57" />°N</label>
      </div>
      <div class="gen-result">
        <figure class="gen-plan" id="ff-plan"></figure>
        <div class="gen-detail" id="ff-detail"></div>
      </div>

      <section class="gen-time" aria-label="계산 과정">
        <div class="gen-process-head">
          <h3>계산 과정: 에너지가 줄면서 실 모양이 정리됩니다</h3>
          <div class="gen-process-ctl">
            <button type="button" class="button-ghost small" id="ff-play">▶ 재생</button>
            <span class="mono" id="ff-now"></span>
          </div>
        </div>
        <p class="note" id="ff-time-note"></p>
        <figure class="gen-time-chart" id="ff-chart"></figure>
        <input type="range" id="ff-slider" class="gen-time-slider" min="0" max="40" step="1" value="40" aria-label="계산 단계" />
        <div class="ff-compare">
          <figure class="gen-plan" id="ff-snap"></figure>
          <div class="gen-process-text" id="ff-snap-text" aria-live="polite"></div>
        </div>
      </section>

      <section class="gen-fx" aria-label="식">
        <div class="gen-process-head"><h3>식: 무엇을 줄이나</h3></div>
        <div class="ff-formula" id="ff-formula"></div>
      </section>

      <section class="gen-fx" aria-label="공간구문">
        <div class="gen-process-head"><h3>공간구문: 정당화 그래프와 변수</h3></div>
        <div class="ff-compare">
          <figure class="gen-plan" id="ff-jpg"></figure>
          <div id="ff-sx-text"></div>
        </div>
      </section>

      <section class="gen-fx" aria-label="요청한 연결">
        <div class="gen-process-head"><h3>요청한 연결 겹쳐 보기: 기준 세대의 연결이 지켜졌나</h3></div>
        <div class="ff-compare">
          <figure class="gen-plan" id="ff-graph"></figure>
          <div id="ff-graph-text"></div>
        </div>
      </section>

      <section class="gen-fx" aria-label="원본과 비교">
        <div class="gen-process-head"><h3>원본 세대와 비교</h3></div>
        <div class="ff-compare2">
          <figure class="gen-plan" id="ff-cmp-orig"></figure>
          <figure class="gen-plan" id="ff-cmp-gen"></figure>
        </div>
      </section>

      <div class="gen-downloads">
        <span class="note">내려받기</span>
        <button type="button" class="button-ghost small" id="ff-json">SPA JSON(AI 허브 형식)</button>
        <button type="button" class="button-ghost small" id="ff-svg">SVG</button>
      </div>

      <details class="gen-method">
        <summary>어떻게 만드나요?</summary>
        <ol>
          <li><b>격자</b>: 기준 세대를 0.3m 칸으로 나눕니다. 현관·발코니·실외기실과 1.5㎡ 미만의 작은 공간(덕트 등)은 원래 칸에 고정하고, 나머지 칸을 다른 실들에 다시 나눠 줍니다. 실은 연결된 칸 묶음이라 ㄱ자·ㄷ자 같은 직교 다각형이 될 수 있습니다.</li>
          <li><b>초기 배치</b>: 실마다 씨앗을 원래 위치에서 '변화 정도'만큼 옮겨 놓고, 모자란 실부터 직사각형으로 한 줄씩 키운 뒤, 더 못 키우면 줄 일부만 넓혀 ㄱ자로 키웁니다(제약 성장, <a href="https://publications.graphics.tudelft.nl/papers/584" target="_blank" rel="noopener">Lopes 외 2010</a>).</li>
          <li><b>다듬기</b>: 담금질(<a href="https://doi.org/10.1126/science.220.4598.671" target="_blank" rel="noopener">Kirkpatrick 외 1983</a>)로 에너지를 줄입니다. 이동은 80%가 '벽 밀기'(두 실이 맞닿은 벽 한 줄을 한 칸 옮김), 20%가 칸 하나 넘기기이며, 실이 둘로 쪼개지는 이동은 하지 않습니다. 확률적 탐색으로 주거 평면을 만드는 방식은 <a href="https://doi.org/10.1145/1882261.1866203" target="_blank" rel="noopener">Merrell 외 2010</a>과 같은 계열입니다.</li>
          <li><b>외곽</b>: '원본 그대로·원본 변형'은 원본 실 배치를 회전·뒤집기·늘이기로 바꿔 씁니다. '모양 고르기·직접 그리기'는 새 외곽에 기준 세대의 실 구성·면적 비율·인접만 가져와, 원본 실 중심을 새 외곽 상자로 옮긴 가중 보로노이로 처음 나누고 현관도 움직입니다(바깥 벽에 문 폭 이상 닿아야 함). 발코니는 고른 면(앞·뒤·왼쪽·오른쪽)마다 가장 바깥 외벽 중 2.4m 이상 이어진 구간을 따라 1.5m로 둡니다. '외곽도 함께 다듬기'는 담금질 이동의 25%를 바깥 벽 칸 붙이기·떼기로 쓰고, 외곽 꼭짓점이 상한(직사각형 위주 6, ㄱ자까지 8, 자유형 12)을 넘으면 벌점을 줍니다. 발코니에 붙은 벽과 갇힌 구멍이 생기는 이동은 하지 않습니다.</li>
          <li><b>문·창</b>: 공용 실(현관·거실·주방·복도)끼리는 트고, 나머지 실은 공용 실(드레스룸·부부욕실은 안방) 쪽으로 문을 냅니다. 거실·침실이 발코니에 닿으면 발코니 문, 아니면 가장 긴 바깥 벽에 창을 냅니다.</li>
        </ol>
        <p class="note">한계: 발코니는 각 면의 가장 바깥 외벽에만 둡니다(안쪽으로 들어간 벽에는 두지 않음). 축척은 침실 크기로 추정했습니다. 벽 두께 없이 칸 경계를 벽으로 그립니다. 설계 검토 전 단계의 배치 아이디어로 써 주세요.</p>
      </details>
    </section>
