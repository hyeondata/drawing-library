---
// QUBO 도면 생성: 도면 생성 탭에서 규칙으로 하던 일(방 크기·모양, 문·창 위치)까지 모두 QUBO 항으로 써서 평면을 만든다.
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import { show } from '../lib/source.js';
import { badges } from '../generate/pipeline.js';
import { TERMS_A, TERMS_B } from '../qubogen/model.js';
import { SOLVERS } from '../generate/solvers.js';
import { buildChoices } from '../generate/choices.js';
import { SYNTAX_CHOICES, LIFESTYLE_CHOICES } from '../generate/preferences.js';
import { PREF_EFFECTS } from '../qubogen/model.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const Q = 'src/qubogen/model.js';
// 이 탭은 SA만 쓰는 규칙의 예외다: 변수 약 600개에서 SA는 실이 흩어진 해를 내 Tabu를 기본으로 둔다(evidence/18-SA-선택-근거.md).
const solvers = SOLVERS.filter((s) => !['cpsat', 'exact'].includes(s.key));
// 도면 생성 탭과 같은 선택지(같은 데이터에서 계산)
const choices = buildChoices();
// 조건 → QUBO에 들어가는 방법
const condMap = [
  ['전용면적', '격자 크기와 모든 실의 목표 칸 수', '면적 항(정확)', 'easy'],
  ['거실 면적 비율', '거실 목표 칸 수', '면적 항(정확)', 'easy'],
  ['침실 수', '실 목록(변수 수)', '변수·면적 항(정확)', 'easy'],
  ['침실 면적(작은방·안방 비중)', '침실 목표 칸 수', '면적 항(정확)', 'easy'],
  ['화장실 2개·드레스룸·다목적실', '실 목록', '변수·면적·맞닿음 항(정확)', 'easy'],
  ['발코니', '남쪽 바깥 줄을 발코니로(있으면 발코니 문, 없으면 창)', '단계 B 창 항(정확)', 'easy'],
  ['실외기실', '바깥 줄의 어느 칸을 실외기실로 쓸지', '단계 B 실외기실 항(정확)', 'easy'],
  ['거실 중심형', '거실이 가운데·여러 실과 닿음', '근사 — 통합도는 그래프 경로라 이차식이 아님. 풀고 나서 실제 통합도 계산', 'hard'],
  ['사생활 깊이', '침실 칸이 현관 칸에서 멀리', '근사 — 깊이는 경로 계산이라 이차식이 아님. 풀고 나서 실제 깊이 계산', 'hard'],
  ['주방–거실 연계', '주방–거실 맞닿음 강화', '맞닿음 항(근사: 통합도 비는 풀고 나서 계산)', 'hard'],
  ['현관–거실 직접 연결', '현관–거실 맞닿음 강화', '맞닿음 항', 'easy'],
  ['넓은 공용 공간', '거실 목표 한 단계 크게', '면적 항(정확)', 'easy'],
  ['화장실 2개', '공용·부부욕실', '실 목록', 'easy'],
  ['침실 소음 분리', '침실끼리·침실–거실 떨어짐 강화', '떨어짐 항(정확)', 'easy'],
  ['채광 확보', '거실·침실을 앞(남)으로, 창 많이', '앞·뒤 띠·창 항', 'easy'],
  ['수납 공간', '드레스룸·다목적실', '실 목록', 'easy'],
  ['외곽 모양', '도면 생성 탭도 직사각형', '이 탭도 직사각형 고정(넣을 수는 있으나 변수가 늘어 느려짐)', 'no'],
];
const prefs = [
  ['livingCentral', '거실 중심형', '거실 가운데 항 ×1.8'],
  ['privacy', '사생활', '침실–현관 떨어짐 항 강화'],
  ['kitchenLink', '대면형 주방', '주방–거실 맞닿음 항 강화'],
  ['entryNear', '현관–거실 가깝게', '현관–거실 맞닿음 항 강화'],
  ['quiet', '방음', '침실끼리 떨어짐 항 강화'],
];
const steps = [
  { n: 1, kinds: ['rule'], title: '격자와 목표 만들기', what: ['전용면적을 칸(1.2m 또는 0.9m)으로 나눈 직사각형 격자로 바꿉니다. 깊이 = 7.4 × (A/84)<sup>0.3</sup>m를 칸 수로 반올림하고, 폭 칸 수 = A ÷ (깊이 칸 × 칸²). 맨 아래(남)에 발코니 줄을 붙입니다.', '실 목록과 목표 면적은 도면 생성과 같은 실 프로그램(+ 복도 7%)이고, 목표 칸 수 t<sub>r</sub> = 목표 면적 비율 × 실내 칸 수입니다.', '이 단계는 QUBO에 넣을 입력(격자·목표)을 준비하는 계산이라 <b>규칙</b>입니다. 결정은 하지 않습니다.'], code: show(Q, 'setupGrid') },
  { n: 2, kinds: ['qubo'], title: '단계 A: 실 배치 QUBO', what: ['변수 x<sub>c,r</sub> = 1이면 칸 c가 실 r에 속합니다. 칸 수 × 실 수만큼 변수가 있습니다.', '도면 생성 탭에서 <b>규칙</b>으로 하던 방 크기·모양(폭 나누기, 복도·부속실)과 앞·뒤 띠, 실 사이 관계를 모두 아래 표의 항으로 씁니다. 실의 순서도, 크기도, 모양도 이 QUBO의 해 하나로 함께 정해집니다.', '고른 풀이기로 이 에너지를 가장 낮게 만드는 x를 찾고, 에너지가 낮은 해 몇 개를 후보로 남깁니다.'], code: show(Q, 'buildStageA') },
  { n: 3, kinds: ['qubo'], title: '단계 B: 문·창 QUBO', what: ['단계 A가 정한 실 경계의 벽 칸마다 "여기에 문(창)을 둔다" 변수를 둡니다.', '도면 생성 탭에서 <b>규칙</b>(우선순위 순서대로 문 달기)으로 하던 것을, 실마다 문 하나(원-핫 벌점) + 이웃 실 종류에 따른 비용 + 문끼리 겹치지 않기 + 창 개수·이어짐 항으로 씁니다.', '두 단계로 나눈 이유: 문 변수는 "벽 칸 × 실 쌍"마다 필요해 한 QUBO에 넣으면 변수가 수천 개가 되어 브라우저에서 풀기 어렵습니다. 그래서 실 배치를 먼저 정하고(단계 A), 그 경계 위에서 문·창을 정합니다(단계 B). 두 단계 모두 QUBO입니다.'], code: show(Q, 'buildStageB') },
  { n: 4, kinds: ['eval'], title: '점검과 고르기', what: ['QUBO로 <b>정확히</b> 쓸 수 없는 규칙을 풀고 난 뒤 따로 점검합니다: 실이 한 덩어리로 이어졌나(연결은 이차식이 아님), 현관에서 문을 따라 모든 실에 갈 수 있나(경로 계산), 최소 폭을 지키나, 거실·침실에 창이 있나, 면적 오차.', '단계 A의 후보마다 단계 B를 풀고 점검해, 점검 점수가 가장 높은 안을 보여 줍니다. 이 점검은 평면을 고치지 않습니다(위반이 있으면 그대로 보여 줌).'], code: show(Q, 'evaluate') },
];
---

<Base title="QUBO 도면 생성 · 평면 생성 랩" description="방 크기·모양과 문·창까지 모든 규칙을 QUBO 항으로 써서 평면을 생성하고, 규칙마다 QUBO 식과 에너지를 보여 줍니다.">
  <Topbar current="qubogen" />
  <section class="hero hero-compact">
    <p class="eyebrow">모든 규칙 → QUBO 항 → 풀이기</p>
    <h1>QUBO <span class="gradient-text">도면 생성</span></h1>
    <p class="lede">도면 생성 탭에서는 QUBO가 <b>방 순서</b>만 정하고 방 크기·문·창은 규칙으로 만듭니다. 이 탭은 그 규칙들까지 <b>모두 QUBO 항으로 써서</b> 평면을 만듭니다. 칸마다 어느 실인지(단계 A)와 문·창 위치(단계 B)를 QUBO로 풀고, QUBO로 정확히 쓸 수 없는 규칙(실의 연결, 현관에서 가는 길)은 풀고 난 뒤 점검합니다.</p>
  </section>

  <main class="qg">
    <form class="qg-form" id="qg-form">
      <fieldset>
        <legend>1. 전용면적</legend>
        <div class="qg-opts">{choices.area.map((o) => <label class="qg-opt"><input type="radio" name="area" value={o.value} data-bedrooms={o.bedrooms} checked={o.value === 84} /><b>{o.label}</b><small>{o.sub}</small></label>)}</div>
      </fieldset>
      <fieldset>
        <legend>2. 거실 면적 비율</legend>
        <div class="qg-opts">{choices.living.map((o) => <label class="qg-opt"><input type="radio" name="living" value={o.key} data-share={o.share} checked={o.key === 'standard'} /><b>{o.label}</b><small>{o.sub}</small></label>)}</div>
      </fieldset>
      <fieldset>
        <legend>3. 침실 수</legend>
        <div class="qg-opts">{choices.bedrooms.map((o) => <label class="qg-opt"><input type="radio" name="bedrooms" value={o.value} checked={o.value === 3} /><b>{o.label}</b><small>{o.sub}</small></label>)}</div>
      </fieldset>
      <fieldset>
        <legend>4. 침실 면적</legend>
        <span class="qg-sub">작은방</span>
        <div class="qg-opts">{choices.roomSize.map((o) => <label class="qg-opt"><input type="radio" name="roomSize" value={o.key} data-share={o.share} checked={o.key === 'standard'} /><b>{o.label}</b><small>{o.sub}</small></label>)}</div>
        <span class="qg-sub">안방 비중</span>
        <div class="qg-opts">{choices.master.map((o) => <label class="qg-opt"><input type="radio" name="master" value={o.key} data-ratio={o.ratio} checked={o.key === 'standard'} /><b>{o.label}</b><small>{o.sub}</small></label>)}</div>
      </fieldset>
      <fieldset>
        <legend>5. 실 구성</legend>
        <div class="qg-opts">{choices.composition.map((o) => <label class="qg-opt"><input type="checkbox" name="composition" value={o.key} checked={o.default} /><b>{o.label}</b><small>{o.sub}</small></label>)}</div>
      </fieldset>
      <fieldset>
        <legend>6. 공간구문 조건(근사 항)</legend>
        <div class="qg-opts">{SYNTAX_CHOICES.map((c) => <label class="qg-opt"><input type="checkbox" name="syntax" value={c.key} checked={c.key === 'livingCentral'} /><b>{c.title}</b><small>{PREF_EFFECTS[c.key]}</small></label>)}</div>
        <label>세기 <select id="qg-sxs"><option value="1" selected>보통(규칙 위반 없이)</option><option value="2">강하게(목표에 더 가깝게, 위반 생길 수 있음)</option></select></label>
      </fieldset>
      <fieldset>
        <legend>7. 생활 조건</legend>
        <div class="qg-opts">{LIFESTYLE_CHOICES.map((c) => <label class="qg-opt"><input type="checkbox" name="lifestyle" value={c.key} /><b>{c.title}</b><small>{PREF_EFFECTS[c.key] || ''}</small></label>)}</div>
      </fieldset>
      <fieldset>
        <legend>8. QUBO 풀기</legend>
        <div class="qg-opts qg-algos">{solvers.map((s) => <label class="qg-opt"><input type="checkbox" name="solver" value={s.key} checked={s.key === 'tabu'} /><b>{s.name}</b><small>{s.family}</small></label>)}</div>
        <label>격자 칸 <select id="qg-cell"><option value="1.2" selected>1.2m(빠름)</option><option value="0.9">0.9m(섬세, 느림)</option></select></label>
        <label>풀이기당 시간 <select id="qg-budget"><option value="1500">1.5초</option><option value="3000" selected>3초</option><option value="6000">6초</option></select></label>
        <label>시드 <input type="number" id="qg-seed" value="1" min="1" max="999" /></label>
      </fieldset>
      <button type="submit" class="button-primary" id="qg-run">QUBO로 도면 생성</button>
      <p class="note" id="qg-status"></p>
      <p class="note">풀이기를 여러 개 고르면 같은 조건·시간·시드로 차례로 풀어 비교합니다. 변수가 수백~천 개이고 벌점이 커서, 한 변수씩 바꾸는 SA·SQA·SB는 이 크기에서 실이 흩어지는 해를 내기 쉽습니다.</p>
    </form>

    <div class="qg-right">
    <section class="qg-card qg-prog" id="qg-prog" hidden aria-live="polite">
      <h2>생성 진행 <span class="note" id="qp-label"></span></h2>
      <div class="qp-bar"><div class="qp-fill" id="qp-fill"></div></div>
      <div class="qp-grid">
        <div>
          <div id="qp-rows"></div>
          <div id="qp-chart"></div>
        </div>
        <figure class="qp-plan" id="qp-plan"><figcaption>지금까지 가장 좋은 배치(단계 A)</figcaption></figure>
      </div>
    </section>
    <section class="qg-card qg-live" id="qg-live" aria-live="polite">
      <div class="qg-live-head">
        <h2>지금 조건의 QUBO 식</h2>
        <div class="qf-tools">
          <span class="qf-legend"><span class="qf-in-s">새로 생김</span><span class="qf-chg-s">값이 바뀜</span><span class="qf-out-s">없어짐</span></span>
          <button type="button" class="button-ghost small" id="qf-openall">모두 펼치기</button>
          <button type="button" class="button-ghost small" id="qf-closeall">모두 접기</button>
        </div>
      </div>
      <p class="note">조건을 바꾸면 식이 바로 바뀝니다. 항 이름을 누르면 그 항의 규칙·일반식·이 조건에서 실마다 들어간 값을 펼쳐 봅니다.</p>
      <div class="qf-stats" id="qf-stats"></div>
      <div class="qf-recent" id="qf-recent"></div>
      <div class="qf-stage-box" id="qf-A"></div>
      <details class="qf-stage-box qf-B" id="qf-Bbox">
        <summary><b>단계 B: 문·창 QUBO</b> <span class="pl-badge pl-qubo">QUBO 최적화</span> <span class="note" id="qf-Bsum"></span></summary>
        <p class="note">단계 B의 변수(벽 칸마다 문·창을 둘지)는 단계 A의 해가 정한 실 경계에 따라 생기므로, 여기서는 항의 모양만 보여 줍니다.</p>
        <div id="qf-B"></div>
      </details>
    </section>
    <div class="qg-out" id="qg-out" hidden>
      <section class="qg-card" id="qg-cmp-card">
        <h2>풀이기 비교</h2>
        <div id="qg-cmp"></div>
      </section>

      <section class="qg-card">
        <h2>생성된 평면 <span id="qg-which" class="note"></span></h2>
        <div class="qg-plan-row">
          <figure class="qg-plan" id="qg-plan"></figure>
          <div id="qg-summary"></div>
        </div>
      </section>

      <section class="qg-card">
        <h2>생성 과정 <span class="note">단계를 누르면 방식과 실제 코드를 봅니다</span></h2>
        <ol class="gen-process-steps qg-steps" id="qg-steps">
          {steps.map((s) => (
            <li><button type="button" data-qstep={s.n}><span class="gen-num">{s.n}</span><span><b>{s.title}</b><span class="pl-mini"><Fragment set:html={badges(s.kinds)} /></span></span></button></li>
          ))}
        </ol>
        <div class="qg-step-body">
          <figure class="qg-plan small" id="qg-step-plan"></figure>
          <div id="qg-step-text"></div>
        </div>
        {steps.map((s) => (
          <template data-qstep-tpl={s.n}>
            <div class="proc-method-head"><b>{s.title}</b> <Fragment set:html={badges(s.kinds)} /></div>
            <ul>{s.what.map((w) => <li set:html={w} />)}</ul>
            <details class="cd-code"><summary>실제 코드 보기</summary><Fragment set:html={s.code} /></details>
          </template>
        ))}
      </section>

      <section class="qg-card">
        <h2>규칙 → QUBO 항 (단계 A: 실 배치)</h2>
        <p class="note">"정확" = 규칙을 그대로 이차식으로 썼음, "근사" = 이차식으로 쓸 수 없어 비슷한 이차식으로 바꿨음(풀고 나서 점검). 에너지 기여는 이 해에서 그 항이 낸 값(낮을수록 잘 지킴).</p>
        <div class="mt-scroll"><table class="gen-table qg-terms" id="qg-termsA"></table></div>
        <h2>규칙 → QUBO 항 (단계 B: 문·창)</h2>
        <div class="mt-scroll"><table class="gen-table qg-terms" id="qg-termsB"></table></div>
      </section>

      <section class="qg-card">
        <h2>규칙 점검 <span class="pl-badge pl-eval">평가</span></h2>
        <div id="qg-checks"></div>
        <h2 style="margin-top:14px">공간구문(풀고 나서 계산) <span class="pl-badge pl-eval">평가</span></h2>
        <div id="qg-syntax"></div>
      </section>

      <section class="qg-card">
        <h2>풀이 과정: 시간에 따른 최저 에너지(단계 A)</h2>
        <div id="qg-trace"></div>
      </section>

      <section class="qg-card">
        <h2>다른 후보(단계 A의 저에너지 해)</h2>
        <div class="qg-cands" id="qg-cands"></div>
      </section>

      <section class="qg-card">
        <h2>도면 생성 탭의 조건은 QUBO에 어떻게 들어가나</h2>
        <div class="mt-scroll"><table class="gen-table qg-terms">
          <thead><tr><th>조건</th><th>무엇을 바꾸나</th><th>QUBO에서</th><th>난이도</th></tr></thead>
          <tbody>{condMap.map(([a, b2, c, d]) => <tr><td><b>{a}</b></td><td>{b2}</td><td>{c}</td><td>{d === 'easy' ? <span class="good-text">쉬움(넣음)</span> : d === 'hard' ? <span class="qg-approx">어려움(근사로 넣음)</span> : <span class="error-text">어려움(넣지 않음)</span>}</td></tr>)}</tbody>
        </table></div>
      </section>

      <section class="qg-card">
        <h2>이 탭에서 QUBO가 아닌 부분</h2>
        <div class="mt-scroll"><table class="gen-table qg-terms">
