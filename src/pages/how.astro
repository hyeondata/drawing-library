---
// 생성 원리: 선택형(도면 생성)과 자유형(자유형 평면)이 어떻게 동작하는지, 단계마다 검증과 근거를 붙여 정리한 읽기용 페이지.
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import Pipeline from '../components/Pipeline.astro';
import { badges } from '../generate/pipeline.js';
import fs from 'node:fs';
import path from 'node:path';
import { SYNTAX } from '../generate/syntax-weights.js';
import { buildChoices } from '../generate/choices.js';
import { defaultParams } from '../generate/compare.js';
import { buildLayout, MIN_SIDE } from '../generate/layout.js';
import { optimize } from '../generate/optimize.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const shapes = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public', 'data', 'shapes.json'), 'utf8'));
const ch = buildChoices();
const b3 = ch.byBedrooms[3];

// ---- 방 크기 예시: 같은 조건에서 깊이 D만 바꿔 실제 코드로 계산 ----
const exSpec = { area: 84, bedrooms: 3, baths: 2, dress: true, multi: false, outdoorUnit: true, balcony: true, targets: { living: ch.living[1].share, ...b3.targets, other: b3.roomSize[1].share, master: b3.roomSize[1].share * b3.master[1].ratio }, prefs: [] };
const exP = defaultParams(exSpec);
const exA = buildLayout(exSpec, { ...exP, depth: 7.1 });
const exB = buildLayout(exSpec, { ...exP, depth: 8.0 });
const opt = optimize(exSpec, { seed: 1, random: 200, refine: 200, count: 1 });
const exC = (opt.top || opt)[0].layout;
const minOf = (r) => (r.key === 'master' ? MIN_SIDE.안방 : MIN_SIDE[r.type]);
const cell = (r) => {
  if (!r) return { t: '—', a: '—', bad: false };
  const m = minOf(r);
  const bad = m !== undefined && Math.min(r.w, r.h) < m - 1e-6;
  return { t: `${r.w.toFixed(2)} × ${r.h.toFixed(2)}`, a: (r.w * r.h).toFixed(1), bad, m };
};
const exRows = exA.rooms.filter((r) => !['발코니', '실외기실', '기타'].includes(r.type)).map((r) => ({ name: r.name, min: minOf(r), a: cell(r), b: cell(exB.rooms.find((x) => x.key === r.key)), c: cell(exC.rooms.find((x) => x.key === r.key)) }));
const badCount = (L) => L.rooms.filter((r) => { const m = minOf(r); return m !== undefined && Math.min(r.w, r.h) < m - 1e-6; }).length;
const exInfo = { a: badCount(exA), b: badCount(exB), c: badCount(exC), cD: exC.D, cW: exC.W };
const R = {
  hillier1987: ['Hillier, Hanson & Graham 1987', 'SSCI', 'https://doi.org/10.1068/b140363'],
  byun2016: ['Byun & Choi 2016', 'SCIE', 'https://doi.org/10.3130/jaabe.15.41'],
  choi2014: ['Choi et al. 2014', 'SCIE', 'https://doi.org/10.3130/jaabe.13.563'],
  seo2007: ['Seo 2007', 'SSCI', 'https://doi.org/10.1068/b32134'],
  ham2017: ['Ham & Lee 2017', 'SCIE·SSCI', 'https://doi.org/10.3390/su9010031'],
  park2024: ['Park, Ergan & Feng 2024', 'SCIE', 'https://doi.org/10.1016/j.autcon.2023.105243'],
  lucas2014: ['Lucas 2014', 'SCIE', 'https://doi.org/10.3389/fphy.2014.00005'],
  ayodele2022: ['Ayodele 2022', '학회', 'https://arxiv.org/abs/2206.11040'],
  jin2011: ['Jin 2011', 'SCIE', 'https://doi.org/10.1016/j.swevo.2011.05.001'],
  dunning2018: ['Dunning et al. 2018', 'SCIE', 'https://doi.org/10.1287/ijoc.2017.0798'],
  michalek2002: ['Michalek et al. 2002', 'SCIE', 'https://doi.org/10.1080/03052150214016'],
  merrell2010: ['Merrell et al. 2010', 'SCIE', 'https://doi.org/10.1145/1882261.1866203'],
  lopes2010: ['Lopes et al. 2010', '학회', 'https://publications.graphics.tudelft.nl/papers/584'],
  kirk1983: ['Kirkpatrick et al. 1983', 'SCIE', 'https://doi.org/10.1126/science.220.4598.671'],
  househgan: ['Nauata et al. 2021(House-GAN++)', '학회', 'https://arxiv.org/abs/2103.02574'],
};
const cite = (id) => `<a class="mt-c" href="${R[id][2]}" target="_blank" rel="noopener">${R[id][0]} · ${R[id][1]}</a>`;
---

<Base title="생성 원리 · 평면 생성 랩" description="선택형(도면 생성)과 자유형(자유형 평면)이 평면을 만드는 방식을 단계별로, 검증 결과와 근거 논문을 붙여 설명합니다.">
  <Topbar current="how" />

  <section class="hero hero-compact">
    <p class="eyebrow">선택형 · 자유형 · 검증 · 근거</p>
    <h1>평면은 이렇게 <span class="gradient-text">만들어집니다</span></h1>
    <p class="lede">이 사이트에는 평면을 만드는 방법이 두 가지 있습니다. <b>선택형</b>(도면 생성 탭)은 조건을 고르면 한국 판상형 아파트 문법으로 평면을 만들고, <b>자유형</b>(자유형 평면 탭)은 실제 아파트 세대(AI 허브 Sample)를 바탕으로 ㄱ자·ㄷ자 같은 사각형이 아닌 실까지 만듭니다. 단계마다 무엇을 하는지, 어떻게 검증했는지, 무엇을 근거로 했는지를 적었습니다. 식과 알고리즘의 자세한 계산은 <a href={`${base}method/`}>방법과 근거</a>에 있습니다.</p>
  </section>

  <main class="mt">
    <nav class="mt-toc" aria-label="목차">
      <ol>
        <li><a href="#cmp">한눈에 비교</a></li>
        <li><a href="#sel">선택형: 단계별</a></li>
        <li><a href="#size">방 크기는 어떻게 정해지나</a></li>
        <li><a href="#free">자유형: 단계별</a></li>
        <li><a href="#common">두 방식이 같이 쓰는 것</a></li>
        <li><a href="#verify">검증 요약</a></li>
        <li><a href="#limits">한계</a></li>
      </ol>
    </nav>

    <section id="kinds" class="mt-sec">
      <h2>0. 무엇이 규칙이고, 무엇이 최적화인가</h2>
      <p><b>도면 생성 탭에서 QUBO가 정하는 것은 "방 순서"(어느 실이 띠의 몇 번째 칸에 가나) 하나뿐입니다.</b> (방 크기·모양과 문·창까지 모두 QUBO로 만드는 방식은 따로 <a href={`${base}qubo-gen/`}>QUBO 도면 생성</a> 탭에 있습니다.) 실 목록·면적, 방 폭 계산, 복도·부속실, 문·창·설비는 정해진 규칙(식)으로 만들고, 깊이·비율 같은 치수는 적합성 J를 보며 조금씩 바꾸는 탐색으로 정합니다. 자유형은 QUBO를 쓰지 않고 담금질로 칸을 나눕니다. 아래 표의 배지는 이 사이트의 모든 탭에서 같은 뜻으로 씁니다.</p>
      <Pipeline />
    </section>

    <section id="cmp" class="mt-sec">
      <h2>1. 한눈에 비교</h2>
      <div class="mt-scroll">
        <table class="gen-table hw-table">
          <thead><tr><th></th><th>선택형(도면 생성)</th><th>자유형(자유형 평면)</th></tr></thead>
          <tbody>
            <tr><td>출발점</td><td>고른 조건(평수·방 개수·구성·선호)</td><td>실제 아파트 세대 하나(Sample {shapes.length}세대 중 선택)</td></tr>
            <tr><td>평면의 틀</td><td>판상형 문법: 앞 띠(거실·침실) + 뒤 띠(주방·현관·욕실)</td><td>기준 세대의 외곽(또는 바꾼 외곽)을 0.3m 칸으로 나눔</td></tr>
            <tr><td>실 모양</td><td>직사각형</td><td>칸 묶음 → 직사각형·ㄱ자·ㄷ자</td></tr>
            <tr><td>무엇을 최적화하나</td><td>실 배치(어느 실이 어느 칸에) → QUBO 또는 직접 탐색, 치수 → 다듬기</td><td>칸을 어느 실에 줄지 → 에너지를 담금질로 줄임</td></tr>
            <tr><td>최적화 방법</td><td>풀이기 11종 중 선택(tabu 계열·SA·PT·SQA·SB·분기한정·열거) 또는 J 직접 탐색</td><td>제약 성장으로 시작 → 담금질(벽 밀기 이동)</td></tr>
            <tr><td>공간구문 반영</td><td>QUBO 대리 항(SCI(E) 변수를 회귀로 근사)</td><td>에너지에서 직접 계산(근사 없음)</td></tr>
            <tr><td>마지막 선택</td><td>목적함수 J(규칙 충족 45% · 면적 25% · 선호 30%)</td><td>에너지가 가장 낮은 안</td></tr>
            <tr><td>계산 시간</td><td>후보 생성 약 1~3초(풀이기당 0.1~1초)</td><td>후보 하나 약 2~3초(이동 3만 번)</td></tr>
          </tbody>
        </table>
      </div>
      <p class="note">둘 다 브라우저 안에서 계산하고, 결과를 AI 허브 라벨과 같은 형식의 JSON으로 내려받을 수 있습니다.</p>
    </section>

    <section id="sel" class="mt-sec">
      <h2>2. 선택형: 단계별</h2>
      <ol class="mt-flow">
        <li><b>조건 고르기</b><span>평수·방·구성·선호</span></li>
        <li><b>목표 정하기</b><span>실별 목표 면적</span></li>
        <li><b>배치 찾기</b><span>QUBO 또는 직접 탐색</span></li>
        <li><b>평면으로 풀기</b><span>판상형 문법</span></li>
        <li><b>문·창·설비</b><span>규칙 + 동선 점검</span></li>
        <li><b>고르기·보여 주기</b><span>J · 진단</span></li>
      </ol>

      <div class="hw-step">
        <h3>① 조건 고르기 → 목표 정하기 <Fragment set:html={badges(['rule'])} /></h3>
        <p>평수, 거실 크기, 침실 수, 작은방 크기·안방 비중, 넣을 실(드레스룸·다목적실·발코니 등), 공간구문 선호(거실 중심형·사생활·대면형 주방), 생활 조건을 차례로 고릅니다.</p>
        <p><b>선택지는 실제 데이터에서 나옵니다.</b> 거실 크기 선택지는 AI 허브 SPA 라벨 전체({ch.source.files.toLocaleString()}건)의 아파트 평면도(APT_FP) {ch.source.units.toLocaleString()}세대에서 잰 "전용면적 대비 거실 면적비"의 분위수(하위 25%·중앙값·상위 25%·10%)이고, 작은방·안방·주방은 고른 침실 수의 세대만으로 같은 방식으로 냅니다. 그래서 고른 값이 실제 아파트에서 흔한 범위 안에 있습니다.</p>
      </div>

      <div class="hw-step">
        <h3>② 배치 찾기: 어느 실이 어느 칸에 가나 <Fragment set:html={badges(['qubo','search'])} /></h3>
        <p>판상형은 앞 띠에 거실과 침실, 뒤 띠에 주방·현관·욕실을 나란히 놓는 한국 아파트의 대표 구조입니다 <Fragment set:html={cite('seo2007')} /> <Fragment set:html={cite('byun2016')} />. 그래서 "평면 만들기"의 핵심 결정은 <b>각 띠에서 실의 순서</b>입니다. 이 결정을 두 가지 방법으로 찾습니다. <b>QUBO는 이 단계에서만 씁니다.</b></p>
        <ul>
          <li><b>QUBO 경로</b>: "실 r이 칸 s에 간다"를 0/1 변수로 두고, 좋은 이웃 관계(주방–거실 맞닿음 등)는 보상, 나쁜 관계(침실–현관)는 감점하는 에너지를 만듭니다. "실마다 칸 하나, 칸마다 실 하나"는 벌점으로 넣습니다 <Fragment set:html={cite('lucas2014')} />. 벌점은 지켜야 할 최소 크기로 정합니다 <Fragment set:html={cite('ayodele2022')} />. 이 에너지를 풀이기 11종 중 고른 것으로 풉니다(양자 어닐러 D-Wave에 그대로 보낼 수 있는 형식).</li>
          <li><b>직접 탐색 경로</b>: 평면을 무작위로 400개 만들고 좋은 4개에서 조금씩 바꿔 400번 더 찾습니다 <Fragment set:html={cite('michalek2002')} />.</li>
        </ul>
        <p><b>QUBO 가중치는 규칙과 문헌으로 정했습니다.</b> 점수에 맞춰 다시 정하지 않습니다. 점수에 맞추면 생성기가 그 점수를 목표로 삼아, 만든 자로 다시 재는 순환이 생기기 때문입니다. 공간구문 변수만 대리 항으로 따로 더합니다 <Fragment set:html={cite('jin2011')} />.</p>
        <p><b>공간구문 선호는 대리 항으로 넣습니다.</b> 통합도·깊이는 그래프 전체를 따라가는 값이라 QUBO 식에 그대로 못 넣습니다. 그래서 SCI(E) 논문의 변수 — 거실/침실 통합도 비 <Fragment set:html={cite('byun2016')} />, 유전형 순서 <Fragment set:html={cite('hillier1987')} />, 공·사 깊이 차 <Fragment set:html={cite('ham2017')} /> — 를 데이터에서 정확히 계산해 QUBO 항으로 회귀했습니다. 예: 거실/침실 비의 근사 정확도 ρ = {SYNTAX.livingBedroomRatio.cv['0.5'].rho.toFixed(2)}, 거실 중심형을 고르면 에너지 최소 배치의 이 값 백분위가 {Math.round(SYNTAX.livingBedroomRatio.cv['0'].varPct * 100)}% → {Math.round(SYNTAX.livingBedroomRatio.cv['0.5'].varPct * 100)}%로 오릅니다.</p>
      </div>

      <div class="hw-step">
        <h3>③ 평면으로 풀기 → 문·창·설비 <Fragment set:html={badges(['rule','search'])} /></h3>
        <p>순서가 정해지면 띠의 폭을 나눕니다. <b>최소 폭(욕실 1.5, 침실 2.4, 안방 3.0, 거실 3.6m)을 먼저 주고</b> 남는 폭을 원하는 크기에 비례해 나눕니다. 띠 폭이 최소 폭의 합보다 모자라면 모두 비례로 줄어 좁은 실이 생길 수 있는데, 그런 실은 감점해 최적화가 피하게 합니다(3절). 깊이·폭 같은 연속값은 <b>탐색</b>으로 30번 조금씩 바꿔 다듬습니다(QUBO 아님). 폭 나누기·복도·부속실은 <b>규칙(식)</b>입니다. 문은 <b>규칙으로</b> 답니다(최적화하지 않음)(침실은 복도·거실 쪽, 부속실은 안방 쪽, 공용 공간끼리는 트기). 그다음 문으로 이어진 그래프에서 현관부터 모든 실에 갈 수 있는지, 침실을 지나야 하는 실이 없는지 점검합니다.</p>
      </div>

      <div class="hw-step">
        <h3>④ 고르기와 보여 주기 <Fragment set:html={badges(['eval'])} /></h3>
        <p>후보마다 목적함수 J = 0.45·규칙 충족률 + 0.25·목표 면적 부합 + 0.30·선호 점수 − 감점(필수 규칙 위반 40, 좁은 실·동선 문제 15)을 계산해 배치가 서로 다른 상위 3안을 보여 줍니다. 규칙은 필수 실, 현관에서의 도달, 침실 비통과, 거실 중심, 주방–거실 맞닿음 같은 시공 가능성 조건이고, 실제 도면과 닮은 정도로 채점하지 않습니다 <Fragment set:html={cite('byun2016')} /> <Fragment set:html={cite('park2024')} />. 선호의 목표 범위는 실제 아파트 평면도 분포(하위 10% ~ 상위 10%)로 정합니다.</p>
        <p>결과 화면은 생성 과정 8단계, 계산 시간에 따른 변화, 식과 변수(영향도), <b>평면 진단</b>(국민주택규모·베이·맞통풍·동선 깊이·채광·환기·요청한 연결·공간구문·실제 방위와 동지 일조), 후보 비교, QUBO 에너지–점수 산점도를 보여 줍니다.</p>
      </div>
    </section>

    <section id="size" class="mt-sec">
      <h2>3. 방 크기는 어떻게 정해지나</h2>
      <p>방의 가로·세로는 <b>고정값이 아니라 변수로 계산되는 식의 결과</b>입니다. 변수 하나를 바꾸면 모든 방의 크기가 함께 다시 계산됩니다. 이 사이트는 "실 배치 + 크기"를 만드는 <b>평면 배치 생성(space layout planning)</b>이며, 벽 두께·구조·상세 치수까지 그리는 시공 도면은 아닙니다(7절 한계).</p>
      <h3>선택형: 변수 → 식 → 크기</h3>
      <div class="mt-scroll"><table class="gen-table hw-table">
        <thead><tr><th>변수</th><th>뜻</th><th>범위</th></tr></thead>
        <tbody>
          <tr><td>D</td><td>평면 깊이(앞뒤 길이)</td><td>7.0~9.8m × (전용면적/84)<sup>0.3</sup></td></tr>
          <tr><td>f</td><td>앞 띠(거실·침실)가 깊이에서 차지하는 비율</td><td>0.46~0.68</td></tr>
          <tr><td>w</td><td>작은방 폭</td><td>2.5~3.6m</td></tr>
          <tr><td>g</td><td>안방 깊이 비율(뒤에 부속실을 붙일 여유)</td><td>0.6~1.0</td></tr>
          <tr><td>실 순서</td><td>띠마다 어느 실이 몇 번째 칸에 가나</td><td>QUBO 풀이기 또는 직접 탐색</td></tr>
        </tbody>
      </table></div>
      <ol class="mt-steps">
        <li><b>세대 폭</b>: W = 전용면적 ÷ D</li>
        <li><b>띠 깊이</b>: 앞 띠 = f × D, 뒤 띠 = D − f × D</li>
        <li><b>원하는 폭</b>: d<sub>i</sub> = 목표 면적<sub>i</sub> ÷ 그 띠의 깊이. 목표 면적은 고른 선택지(아파트 평면도 전체의 면적비 분위수) × 전용면적</li>
        <li><b>실제 폭</b>: w<sub>i</sub> = m<sub>i</sub> + (W − Σm) × max(0, d<sub>i</sub> − m<sub>i</sub>) ÷ Σ max(0, d<sub>j</sub> − m<sub>j</sub>). m<sub>i</sub>는 최소 폭(욕실 1.5, 현관 1.2, 주방 2.2, 침실 2.4, 안방 3.0, 거실 3.6m). <b>띠 폭이 최소 폭의 합보다 넓으면</b> 최소 폭을 먼저 주고 남는 폭만 비례로 나누므로 어떤 실도 최소 폭 아래로 내려가지 않습니다. <b>띠 폭이 모자라면</b>(한 띠에 실이 많은데 깊이가 깊어 세대 폭이 좁을 때) 모든 실을 최소 폭에 비례해 줄일 수밖에 없고, 이때는 미달한 실마다 '좁은 실' 감점(−15점)을 줘서 최적화가 그런 변수 조합을 피하게 하고, 결과 화면에도 경고를 띄웁니다.</li>
        <li><b>실 크기</b>: 가로 = w<sub>i</sub>, 세로 = 띠 깊이(안방은 × g, 남는 뒤쪽은 복도·부속실)</li>
      </ol>
      <p><b>누가 변수를 정하나</b>: 최적화가 정합니다. 직접 탐색은 변수를 바꿔 가며 평면 800개를 평가하고, QUBO 경로는 실 순서를 정한 뒤 D·f·w·g를 30번 다듬어 목적함수 J(목표 면적 부합 포함)가 가장 높은 값을 고릅니다. 결과 화면의 <b>"식과 변수"</b>에서 슬라이더로 직접 바꿔 보고, 각 변수가 어느 방 크기에 얼마나 영향을 주는지(영향도 그림) 볼 수 있습니다.</p>
      <h3>예: 같은 84㎡ · 방 3개에서 깊이만 바꾸면, 그리고 최적화하면</h3>
      <div class="mt-scroll"><table class="gen-table hw-table">
        <thead><tr><th>실(최소 폭)</th><th>기본값, D = 7.1m(폭 {(84 / 7.1).toFixed(2)}m)</th><th>기본값, D = 8.0m(폭 {(84 / 8.0).toFixed(2)}m)</th><th>최적화 결과, D = {exInfo.cD.toFixed(2)}m(폭 {exInfo.cW.toFixed(2)}m)</th></tr></thead>
        <tbody>{exRows.map((r) => <tr><td>{r.name}{r.min ? ` (${r.min}m)` : ''}</td>{[r.a, r.b, r.c].map((x) => <td class={`mono ${x.bad ? 'error-text' : ''}`}>{x.t} m · {x.a}㎡{x.bad ? ' ✗' : ''}</td>)}</tr>)}</tbody>
        <tbody><tr><td><b>최소 폭 미달</b></td><td class="mono">{exInfo.a}개</td><td class="mono">{exInfo.b}개</td><td class="mono"><b>{exInfo.c}개</b></td></tr></tbody>
      </table></div>
      <p class="note">빌드할 때 실제 생성 코드로 계산한 값입니다. 왼쪽 두 열은 최적화 없이 기본값(f = {exP.frontShare}, w = {exP.bedWidth}m, g = {exP.masterDepth}, 앞 띠 침실 1개)에서 깊이만 바꾼 것입니다. 깊이가 늘면 폭이 줄어 방들이 좁고 깊어집니다. 이 기본값은 뒤 띠에 침실 둘과 주방·현관·욕실이 함께 들어가 띠 폭이 최소 폭의 합보다 모자라므로, 침실·주방이 최소 폭에 못 미칩니다(✗). 오른쪽 열은 같은 조건을 직접 탐색(400번)으로 최적화한 결과로, 감점 때문에 깊이·앞 띠 침실 수·실 순서가 바뀌어 미달이 {exInfo.c}개가 됩니다.</p>
      <h3>자유형: 칸을 나눠 주며 정해지는 크기</h3>
      <p>자유형에는 이런 식이 없습니다. 세대를 0.3m 칸으로 나누고 "어느 칸을 어느 방에 줄지"를 담금질로 정하므로, 방의 크기와 모양(직사각형·ㄱ자·ㄷ자)이 함께 정해집니다. 크기는 0.3m 단위이고, 목표 면적(기준 세대의 면적 비율 × 고른 전용면적)과의 차이, 최소 폭(거실 3.0·침실 2.4·주방 1.8m…)보다 좁은 부분, 둘레·꼭짓점이 에너지에 들어가 크기를 끌어당깁니다. 결과 화면은 실마다 목표·생성 면적, 차이(%), 모양, 사각형 비율을 보여 줍니다.</p>
      <h3>중심선 치수와 안목 치수</h3>
      <p>위의 크기는 모두 <b>벽 중심선 기준</b>입니다(법정 전용면적도 중심선 기준). 실제로 가구를 놓을 수 있는 <b>안목 치수</b>는 경계마다 벽 두께의 절반을 뺀 값입니다: 바깥·발코니 쪽은 외벽 0.2m의 절반 0.1m, 실내끼리는 내벽 0.12m의 절반 0.06m. 예: 중심선 2.40 × 3.37m 침실(왼쪽·위가 바깥) → 안목 2.24 × 3.21m. 이 규칙은 AI 허브 형식 내보내기(STR)에서 벽체를 만드는 규칙과 같습니다.</p>
      <ul>
        <li><b>선택형</b>: 결과 위의 "안목 치수"를 누르면 도면에 실마다 안목 면적과 안목 가로×세로(mm)가 표시되고, 실 목록 표에 중심선·안목 치수가 나란히 나옵니다. 84㎡ 예에서 실내 안목 면적 합계는 중심선 전용면적의 약 90%입니다.</li>
        <li><b>자유형</b>: ㄱ자 실은 가로·세로가 하나로 정해지지 않아, 안목 면적을 "칸 면적 − 경계 길이 × 벽 절반 두께"로 근사해 표에 보입니다(오목한 모서리의 작은 겹침은 무시).</li>
      </ul>
    </section>

    <section id="free" class="mt-sec">
      <h2>4. 자유형: 단계별</h2>
      <ol class="mt-flow">
        <li><b>세대 고르기</b><span>Sample {shapes.length}세대</span></li>
        <li><b>외곽 정하기</b><span>원본·변형·모양·그리기</span></li>
        <li><b>격자로 나누기</b><span>0.3m 칸</span></li>
        <li><b>처음 나누기</b><span>제약 성장</span></li>
        <li><b>다듬기</b><span>담금질</span></li>
        <li><b>문·창·진단</b><span>동선·일조·공간구문</span></li>
      </ol>

      <div class="hw-step">
        <h3>① 세대 고르기 → 외곽 정하기 <Fragment set:html={badges(['rule'])} /></h3>
        <p>AI 허브 아파트 평면도(APT_FP) 전체를 분석기로 세대별로 나누고, 면적이 외접 사각형의 85% 미만인 실(ㄱ자 거실 등)이 있는 세대 가운데 원본 배치가 현관에서 모든 실로 이어지는 세대 중 침실 수(2~5개)마다 비정형 실이 많은 세대를 골라 {shapes.length}개를 두었습니다. 한 세대를 고르면 그 세대의 <b>실 구성·면적 비율·실 사이 연결</b>을 물려받습니다.</p>
        <p>외곽은 원본 그대로, 원본을 회전·뒤집기·늘이기, 템플릿(직사각형·ㄱ자·ㄷ자·凸자·엇갈림), 직접 그리기 중에서 정합니다. 발코니는 고른 면(앞·뒤·왼쪽·오른쪽)의 바깥 외벽을 따라 1.5m로 둡니다.</p>
      </div>

      <div class="hw-step">
        <h3>② 격자로 나누기 → 처음 나누기 <Fragment set:html={badges(['rule'])} /></h3>
        <p>세대를 0.3m 칸으로 나누고, 칸마다 어느 실인지 정하는 문제로 바꿉니다. 실은 "이어진 칸 묶음"이라 직사각형뿐 아니라 ㄱ자·ㄷ자가 됩니다. 처음 배치는 <b>제약 성장</b>으로 만듭니다 <Fragment set:html={cite('lopes2010')} />: 실마다 씨앗을 놓고, 모자란 실부터 직사각형으로 한 줄씩 키우다가 막히면 일부만 넓혀 ㄱ자로 키웁니다.</p>
      </div>

      <div class="hw-step">
        <h3>③ 다듬기: 담금질로 에너지 줄이기 <Fragment set:html={badges(['sa'])} /></h3>
        <p>에너지는 "고쳐야 할 점의 합"입니다: 목표 면적과의 차이, 쓸데없이 구불구불함, 꼭짓점이 너무 많음, 가구를 못 놓을 만큼 좁은 부분, 원본에서 이어졌던 실이 떨어짐, 거실·침실에 창이 없음, <b>현관에서 문으로 갈 수 없는 실</b>, 침실을 지나야 들어가는 실, (고르면) 공간구문 목표 미달. 담금질 <Fragment set:html={cite('kirk1983')} /> <Fragment set:html={cite('merrell2010')} />은 이 합을 줄이는 쪽으로 칸을 옮기되, 처음에는 나빠지는 이동도 가끔 받아들여 막다른 배치에서 빠져나옵니다.</p>
        <p><b>"벽 밀기"를 주 이동으로 씁니다.</b> 칸 하나씩 옮기면 거의 매번 꼭짓점이 늘어 에너지가 오릅니다(실측: 가능한 이동 282개 중 좋아지는 것 10개). 그래서 두 실이 맞닿은 벽 한 줄을 통째로 한 칸 미는 이동을 80% 씁니다. 실이 둘로 쪼개지는 이동은 하지 않습니다. 이 변경으로 에너지가 82 → 16으로 줄었습니다.</p>
        <p><b>공간구문은 직접 계산합니다.</b> 자유형은 QUBO가 아니라서 매 이동마다 분석기와 같은 정의로 통합도·깊이를 계산해 문헌 목표(거실/침실 비 1.9, 공·사 깊이 차 1.5)에 못 미친 만큼 벌점을 줍니다.</p>
      </div>

      <div class="hw-step">
        <h3>④ 문·창 → 진단 <Fragment set:html={badges(['rule','eval'])} /></h3>
        <p>문·창은 <b>규칙으로</b> 붙입니다(담금질 에너지는 문을 낼 수 있는 맞닿음만 확보). 공용 실끼리는 트고, 나머지 실은 현관에서 이어진 공용 실 쪽부터 차례로 문을 냅니다. 거실·침실이 발코니에 닿으면 발코니 문, 아니면 가장 긴 바깥 벽에 창을 냅니다. 결과 화면은 실별 면적·모양, 원본 연결 유지, 계산 과정(에너지 그래프와 그 시점 배치), 식(항별 기여), 공간구문 정당화 그래프, 방위와 동지 일조를 보여 줍니다.</p>
      </div>
    </section>

    <section id="common" class="mt-sec">
      <h2>5. 두 방식이 같이 쓰는 것</h2>
      <ul>
        <li><b>공간구문 정의</b>: 실 = 노드, 맞닿음 = 링크, 덕트 제외, 현관에 외부 노드, 통합도 = 1/RRA <Fragment set:html={cite('byun2016')} />. 분석기(spa.js·syntax.js)의 계산 함수를 그대로 씁니다.</li>
        <li><b>방위와 동지 일조</b>: 앞쪽(발코니 쪽) 방위와 위도를 넣으면 창마다 향을 정하고, 동지 08~16시 태양 위치로 해 드는 시간을 계산해 판례 기준(총 4시간 또는 연속 2시간)과 비교합니다. 이웃 동 그림자가 없는 최대치입니다.</li>
        <li><b>요청한 연결 겹쳐 보기</b>: 요청(규칙·선호 또는 원본 세대)의 연결을 결과 평면 위에 충족·문 없음·빠짐·어김으로 그립니다 <Fragment set:html={cite('househgan')} />.</li>
        <li><b>AI 허브 형식 내보내기</b>: Sample과 같은 23개 범주, COCO 형식 JSON.</li>
