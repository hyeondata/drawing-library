---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import { REFERENCES } from '../model/config.js';
import { buildChoices } from '../generate/choices.js';
import { LIFESTYLE_CHOICES, SYNTAX_CHOICES } from '../generate/preferences.js';
import { ACTIVE, SOLVERS } from '../generate/solvers.js';
import { GEN_STAGES } from '../generate/pipeline.js';
import { show, showSeg } from '../lib/source.js';

// 생성 알고리즘은 SA만 켠다(근거: evidence/18-SA-선택-근거.md). 다른 풀이기는 코드와 비교 실험에만 남긴다.
// 시간 선택지 옆의 전역 최적 도달률: evidence/results/sa-experiment.json(손으로 옮겨 적지 않음)
const SAX = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'evidence', 'results', 'sa-experiment.json'), 'utf8'));
const stopOf = (k) => SAX.stop.find((r) => r.stopHits === k);
const stopLabel = (k) => { const r = stopOf(k); return r ? `최적 ${Math.round(r.p * 100)}%, 보통 ${(r.ms.p50 / 1000).toFixed(1)}초` : ''; };
const algos = SOLVERS.filter((s) => ACTIVE.includes(s.key)).map((s) => ({ key: s.key, name: s.name, family: s.family, cite: s.cite }));

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// 생성 과정 단계마다 실제 코드(빌드 때 소스에서 잘라 옴)
const codeOf = (list) => (list || []).map((c) => (c.length === 3 ? showSeg(c[0], c[1], c[2]) : show(c[0], c[1]))).join('');
const procCode = GEN_STAGES.map((g) => ({ code: codeOf(g.code), model: codeOf(g.modelCode) }));
const choices = buildChoices();
const refOf = Object.fromEntries(REFERENCES.map((r) => [r.id, { short: r.short, url: r.url, index: r.index }]));
const strip = (c) => ({ key: c.key, short: c.short, title: c.title, desc: c.desc, metrics: c.metrics, refs: c.refs, note: c.note || null, effect: c.effect || null });
const src = choices.source;

const steps = [
  { key: 'area', title: '전용면적', q: '전용면적 선택' },
  { key: 'living', title: '거실 면적', q: '거실 면적 비율(전용면적 대비)' },
  { key: 'bedrooms', title: '침실 수', q: '침실 수' },
  { key: 'roomSize', title: '침실 면적', q: '침실 면적(작은방 면적 비율, 안방 비중)' },
  { key: 'composition', title: '실 구성', q: '실 구성(복수 선택)' },
  { key: 'syntax', title: '공간구문 조건', q: '공간구문 조건: 동선과 공간 위계(복수 선택)' },
  { key: 'lifestyle', title: '생활 조건', q: '생활 조건(복수 선택)' },
  { key: 'result', title: '최적 도면', q: '조건에 맞춰 만든 평면과 그 평면이 만들어지는 과정입니다.' },
];
---

<Base title="도면 생성 · 평면 생성 랩" description="전용면적·거실·침실·실 구성과 공간구문·생활 조건을 선택하면 판상형 아파트 평면을 만들고, 만들어지는 과정을 단계별로 보여 줍니다.">
  <Topbar current="generate" />

  <section class="hero hero-compact">
    <p class="eyebrow">조건 → 생성 → 적합성으로 최적화</p>
    <h1>도면 <span class="gradient-text">생성하기</span></h1>
    <p class="lede">
      전용면적부터 생활 조건까지 차례로 선택하면 판상형 아파트 평면을 수백 개 만들어 조건에 가장 잘 맞는 안을 고르고, 그 평면이 전용면적 사각형에서 문·창·설비까지 어떻게 만들어지는지 단계별로 보여 줍니다.
      크기·개수·구성 선택지는 AI 허브 SPA 라벨 전체({src.files.toLocaleString()}건)의 아파트 평면도(APT_FP) {src.units.toLocaleString()}세대에서, 공간구문·생활 조건은 공간구문 변수·규칙과 그 근거 논문에서 가져왔습니다.
    </p>
  </section>

  <main class="gen" id="gen">
    <ol class="gen-steps" aria-label="단계">
      {steps.map((s, i) => (
        <li>
          <button type="button" data-goto={i} aria-current={i === 0 ? 'step' : undefined} disabled={i > 0}>
            <span class="gen-num">{i + 1}</span>
            <span>{s.title}</span>
          </button>
        </li>
      ))}
    </ol>

    <div class="gen-body">
      <form class="gen-panel" id="gen-form" novalidate>
        <!-- 1. 평수 -->
        <div class="gen-step" data-step="0">
          <h2>{steps[0].q}</h2>
          <div class="gen-options" data-group="area">
            {choices.area.map((o) => (
              <label class="gen-opt"><input type="radio" name="area" value={o.value} data-bedrooms={o.bedrooms} checked={o.value === 84} />
                <strong>{o.label}</strong>
                <span>{o.sub}</span>
                {o.note && <span class="gen-opt-note">{o.note}</span>}
              </label>
            ))}
          </div>
          <p class="note">라벨에는 실제 치수(축척)가 없어 면적은 라벨에서 정하지 못합니다. 국민주택 규모(85㎡) 안팎의 대표 주택형을 선택지로 두고, 실 크기는 아래 단계에서 라벨의 면적비로 나눕니다.</p>
        </div>

        <!-- 2. 거실 크기 -->
        <div class="gen-step" data-step="1" hidden>
          <h2>{steps[1].q}</h2>
          <div class="gen-options" data-group="living">
            {choices.living.map((o) => (
              <label class="gen-opt"><input type="radio" name="living" value={o.key} data-share={o.share} checked={o.key === 'standard'} />
                <strong>{o.label}</strong>
                <span class="gen-m2" data-share-m2={o.share}></span>
                <span>{o.sub}</span>
              </label>
            ))}
          </div>
          <p class="note">아파트 평면도 {src.units.toLocaleString()}세대에서 전용면적(발코니·실외기실 제외) 대비 거실 면적비의 분위수입니다(침실 수별 차이가 작아 전체로 잡음).</p>
        </div>

        <!-- 3. 방 개수 -->
        <div class="gen-step" data-step="2" hidden>
          <h2>{steps[2].q}</h2>
          <div class="gen-options" data-group="bedrooms">
            {choices.bedrooms.map((o) => (
              <label class="gen-opt"><input type="radio" name="bedrooms" value={o.value} checked={o.value === 3} />
                <strong>{o.label}</strong>
                <span>{o.sub}</span>
              </label>
            ))}
          </div>
          <p class="note">아파트 평면도 세대의 침실 수 분포입니다(6개 이상은 판상형 한 줄에 들어가지 않아 뺌). 전용면적을 선택하면 그 주택형에서 흔한 개수가 먼저 선택됩니다.</p>
        </div>

        <!-- 4. 방 크기 -->
        <div class="gen-step" data-step="3" hidden>
          <h2>{steps[3].q}</h2>
          <h3 class="gen-sub">작은방 크기</h3>
          <div class="gen-options" data-group="roomSize">
            {choices.roomSize.map((o) => (
              <label class="gen-opt"><input type="radio" name="roomSize" value={o.key} data-share={o.share} checked={o.key === 'standard'} />
                <strong>{o.label}</strong>
                <span class="gen-m2" data-share-m2={o.share}></span>
                <span>{o.sub}</span>
              </label>
            ))}
          </div>
          <h3 class="gen-sub">안방 비중</h3>
          <div class="gen-options" data-group="master">
            {choices.master.map((o) => (
              <label class="gen-opt"><input type="radio" name="master" value={o.key} data-ratio={o.ratio} checked={o.key === 'standard'} />
                <strong>{o.label}</strong>
                <span>{o.sub}</span>
              </label>
            ))}
          </div>
          <p class="note">작은방은 전용 대비 면적비, 안방은 '안방/다른 침실 면적비'(Zeng et al. 2025)의 분위수이며, 고른 침실 수의 세대만으로 계산합니다(방이 많을수록 작은방이 작아짐).</p>
        </div>

        <!-- 5. 방 구성 -->
        <div class="gen-step" data-step="4" hidden>
          <h2>{steps[4].q}</h2>
          <div class="gen-options gen-multi" data-group="composition" data-multi>
            {choices.composition.map((o) => (
              <label class="gen-opt"><input type="checkbox" name="composition" value={o.key} checked={o.default} />
                <strong>{o.label}</strong>
                <span>{o.sub}</span>
              </label>
            ))}
          </div>
          <p class="note">비율은 아파트 평면도 {src.units.toLocaleString()}세대 가운데 그 실이 있는 세대의 비율입니다. 현관·거실·주방·침실·화장실은 필수 실이라 항상 넣습니다. 침실 수를 고르면 그 침실 수 세대의 절반 이상이 가진 실이 먼저 켜집니다. 화장실 3개는 침실 쪽에 욕실3을 하나 더 둡니다(4개 이상은 고유 세대의 6%라 지원하지 않음).</p>
        </div>

        <!-- 6. 공간구문 -->
        <div class="gen-step" data-step="5" hidden>
          <h2>{steps[5].q}</h2>
          <div class="gen-options gen-multi gen-wide" data-group="syntax" data-multi>
            {SYNTAX_CHOICES.map((c) => (
              <label class="gen-opt"><input type="checkbox" name="syntax" value={c.key} checked={c.key === 'livingCentral'} />
                <strong>{c.title}</strong>
                <span>{c.desc}</span>
                <span class="gen-metrics">지표: {c.metrics.join(' · ')}</span>
                <span class="cites">{c.refs.map((id) => <a class="cite" href={refOf[id].url} target="_blank" rel="noopener">{refOf[id].short}</a>)}</span>
              </label>
            ))}
          </div>
          <p class="note">문 정보가 없는 인접 그래프에서 계산하는 공간구문 변수·규칙입니다. 고른 항목은 최적화 목적함수에 더해지고, 변수의 목표 범위는 실제 아파트 평면도 분포(하위 10% ~ 상위 10%)로 정했습니다.</p>
        </div>

        <!-- 7. 생활 조건 -->
        <div class="gen-step" data-step="6" hidden>
          <h2>{steps[6].q}</h2>
          <div class="gen-options gen-multi gen-wide" data-group="lifestyle" data-multi>
            {LIFESTYLE_CHOICES.map((c) => (
              <label class="gen-opt"><input type="checkbox" name="lifestyle" value={c.key} />
                <strong>{c.title}</strong>
                <span>{c.desc}</span>
                <span class="gen-metrics">지표: {c.metrics.join(' · ')}{c.effect && ` · 조건: ${c.effect}`}</span>
                {c.refs.length > 0 && <span class="cites">{c.refs.map((id) => <a class="cite" href={refOf[id].url} target="_blank" rel="noopener">{refOf[id].short}</a>)}</span>}
                {c.note && <span class="gen-opt-note">{c.note}</span>}
              </label>
            ))}
          </div>
        </div>

        <!-- 8. 결과 -->
        <div class="gen-step" data-step="7" hidden>
          <h2>{steps[7].q}</h2>
          <fieldset class="gen-algos" id="gen-algos">
            <legend>생성 알고리즘</legend>
            <p class="note">
              실 배치를 <b>QUBO</b>(실×칸 이진 변수, 원-핫 벌점 + 실 쌍 인접 항)로 만들어 <b>SA(담금질)</b>로 풀고, 좋은 해를 평면으로 풀어 적합성 J(규칙 충족 + 목표 면적 + 선호)로 서로 다른 3안을 고릅니다.
              다른 풀이기(tabu 계열·PT·SQA·SB·분기한정·열거)와 직접 탐색은 꺼 두었습니다. SA만 쓰는 이유: <a href={`${base}method/#sa-only`}>방법과 근거 5.0절</a>.
            </p>
            <div class="gen-algo-list">
              {algos.map((a) => (
                <label class="gen-algo">
                  <input type="checkbox" name="algo" value={a.key} checked disabled />
                  <span>
                    <strong>{a.name}</strong>
                    <span class="note">{a.family}{a.cite && a.cite !== '—' ? ` · ${a.cite}` : ''}</span>
                  </span>
                </label>
              ))}
            </div>
            <div class="gen-algo-actions">
              <label class="gen-inline">최대 시간
                <select id="gen-budget">
                  <option value="3000">3초</option>
                  <option value="10000">10초</option>
                  <option value="30000" selected>30초(기본)</option>
                </select>
              </label>
              <label class="gen-inline">멈춤 조건
                <select id="gen-stop">
                  {SAX.stop.map((r) => <option value={r.stopHits} selected={r.stopHits === SAX.defaultStop}>같은 최저를 {r.stopHits}번 다시 찾으면({stopLabel(r.stopHits)}){r.stopHits === SAX.defaultStop ? ', 기본' : ''}</option>)}
                  <option value="full">끝까지(최대 시간까지 계속)</option>
                </select>
              </label>
              <label class="gen-inline">시드 <input type="number" id="gen-seed" value="1" min="1" max="9999" /></label>
              <button type="button" class="button-primary" id="gen-run">SA로 다시 생성</button>
              <button type="button" class="button-ghost small" id="gen-qubo">QUBO 내보내기(D-Wave·Gurobi용)</button>
            </div>
            <p class="note">
              <b>최대 시간</b>은 SA가 QUBO를 푸는 데 쓸 수 있는 한도이고, <b>멈춤 조건</b>은 그 전에 끝내는 규칙입니다. SA는 무작위 시작에서 여러 번 다시 풀며(재시작), 지금까지 찾은 가장 낮은 에너지를 정한 횟수만큼 다시 찾으면 더 낮은 해가 없다고 보고 멈춥니다. "끝까지"는 최대 시간을 다 씁니다. 해를 평면으로 풀고 고르는 시간은 따로 듭니다(측정값: evidence/results/sa-experiment.md, 최대 {SAX.maxMs / 1000}초 기준).
              평면 품질은 풀이 시간보다 아래 QUBO 가중치(J와 얼마나 맞는가)가 좌우합니다.
            </p>
            <details class="pl-what gen-qw" id="gen-qw" open>
              <summary><b>QUBO 가중치</b>: 지금 고른 조건으로 만든 QUBO의 항별 계수</summary>
              <div id="gen-qw-table"></div>
            </details>
            <p class="note">
              내보낸 QUBO JSON은 <a href={`${base}qubo/solve_qubo.py`} download>solve_qubo.py</a>로 D-Wave(SA·Tabu·QPU·Hybrid)·Gurobi·CP-SAT에서 풀 수 있습니다.
              같은 QUBO에서 D-Wave SA·Tabu와 CP-SAT가 이 화면의 전수 열거로 구한 전역 최적해와 같은 에너지를 내는 것을 확인했습니다. QPU는 Leap 계정이 있어야 합니다.
            </p>
          </fieldset>
          <div class="gen-progress" id="gen-progress" hidden>
            <div class="gen-bar"><i id="gen-bar"></i></div>
            <p class="note" id="gen-progress-text">평면을 만드는 중…</p>
          </div>
          <div id="gen-result" hidden>
            <div class="gen-toolbar">
              <div class="seg gen-tabs" role="tablist" id="gen-tabs"></div>
              <div class="seg" role="group" aria-label="도면 표시">
                <button type="button" data-view="full" aria-pressed="true">모든 요소</button>
                <button type="button" data-view="space" aria-pressed="false">실만</button>
              </div>
              <div class="seg" role="group" aria-label="치수 기준">
                <button type="button" data-dims="center" aria-pressed="true">중심선 치수</button>
                <button type="button" data-dims="net" aria-pressed="false">안목 치수</button>
              </div>
            </div>
            <div id="gen-compare"></div>
            <div class="gen-result">
              <figure class="gen-plan" id="gen-plan"></figure>
              <div class="gen-detail" id="gen-detail"></div>
            </div>
            <section class="gen-diag" id="gen-diag" aria-label="평면 진단" hidden></section>
            <section class="gen-process" id="gen-process" aria-label="생성 과정">
              <div class="gen-process-head">
                <h3>생성 과정</h3>
                <div class="gen-process-ctl">
                  <button type="button" class="button-ghost small" id="proc-prev" aria-label="이전 단계">←</button>
                  <span class="mono" id="proc-count">1 / 8</span>
                  <button type="button" class="button-ghost small" id="proc-next" aria-label="다음 단계">→</button>
                  <button type="button" class="button-ghost small" id="proc-play">▶ 자동 재생</button>
                </div>
              </div>
              <ol class="gen-process-steps" id="proc-steps"></ol>
              <div class="gen-process-body">
                <figure class="gen-plan" id="proc-plan"></figure>
                <div class="gen-process-text" id="proc-text" aria-live="polite"></div>
              </div>
              <div class="proc-method" id="proc-method"></div>
              <details class="proc-allrules" id="proc-allrules"><summary><b>이 평면에 쓰인 규칙 전체 보기</b></summary><div class="gr-all"></div></details>
              {procCode.map((c, i) => (
                <>
                  <template data-proc-code={String(i + 1)} set:html={c.code} />
                  {c.model && <template data-proc-code={`${i + 1}m`} set:html={c.model} />}
                </>
              ))}
            </section>
            <section class="gen-fx" id="gen-fx" aria-label="식과 변수">
              <div class="gen-process-head">
                <h3>식과 변수: 무엇이 평면을 바꾸나</h3>
                <button type="button" class="button-ghost small" id="fx-reset">이 안의 값으로</button>
              </div>
              <p class="note">이 안을 만든 변수입니다. 바꾸면 평면과 아래 식의 값이 바로 다시 계산됩니다(같은 실 순서를 유지). 영향 그림은 각 변수를 조금 줄이고(−) 늘렸을 때(+) 고른 결과가 얼마나 움직이는지 보여 줍니다.</p>
              <div class="gen-fx-top">
                <div class="gen-fx-controls" id="fx-controls"></div>
                <figure class="gen-plan" id="fx-plan"></figure>
              </div>
              <div class="gen-fx-influence">
                <label class="mth-select">영향을 볼 결과 <select id="fx-output"></select></label>
                <figure class="gen-fx-tornado" id="fx-tornado"></figure>
              </div>
              <div class="gen-fx-cards" id="fx-cards"></div>
            </section>
            <section class="gen-time" id="gen-time" aria-label="계산 시간에 따른 과정">
              <div class="gen-process-head">
                <h3>계산 시간에 따른 과정</h3>
                <div class="gen-process-ctl">
                  <button type="button" class="button-ghost small" id="time-play">▶ 재생</button>
                  <span class="mono" id="time-now"></span>
                </div>
              </div>
              <p class="note" id="time-note"></p>
              <figure class="gen-time-chart" id="time-chart"></figure>
              <input type="range" id="time-slider" class="gen-time-slider" min="0" max="1000" step="1" value="1000" aria-label="계산 시각" />
              <div class="gen-process-body">
