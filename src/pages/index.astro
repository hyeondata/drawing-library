---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import { REFERENCES } from '../model/config.js';
import { buildChoices } from '../generate/choices.js';
import { LIFESTYLE_CHOICES, SYNTAX_CHOICES } from '../generate/preferences.js';
import { ACTIVE, RESEARCH_GEN, SOLVERS } from '../generate/solvers.js';
import { GEN_STAGES } from '../generate/pipeline.js';
import { show, showSeg } from '../lib/source.js';
import { largest, maskFromUnit } from '../freeform/outline.js';

// 생성 알고리즘은 SA만 켠다(근거: evidence/18-SA-선택-근거.md). 다른 풀이기는 코드와 비교 실험에만 남긴다.
const algos = [RESEARCH_GEN, ...SOLVERS].filter((s) => ACTIVE.includes(s.key)).map((s) => ({ key: s.key, name: s.name, family: s.family, cite: s.cite }));

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// 생성 과정 단계마다 실제 코드(빌드 때 소스에서 잘라 옴)
const codeOf = (list) => (list || []).map((c) => (c.length === 3 ? showSeg(c[0], c[1], c[2]) : show(c[0], c[1]))).join('');
const procCode = GEN_STAGES.map((g) => ({ code: codeOf(g.code), model: codeOf(g.modelCode) }));
const choices = buildChoices();
const refOf = Object.fromEntries(REFERENCES.map((r) => [r.id, { short: r.short, url: r.url, index: r.index }]));
const strip = (c) => ({ key: c.key, short: c.short, title: c.title, desc: c.desc, metrics: c.metrics, refs: c.refs, note: c.note || null, effect: c.effect || null });
const src = choices.source;
// 0. 외곽 형태: scripts/build-outlines.mjs가 AI 허브 APT_FP 전체 세대의 외곽을 묶은 결과(대표 외곽 미리보기는 빌드 때 그림)
const OUTL = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'public', 'data', 'outlines.json'), 'utf8'));
// 외곽 투영 검증(scripts/outline-projection.mjs)을 통과한 외곽 × 침실 수: 그 조합만 정확 QUBO + SA로 생성한다.
const PROJ = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'evidence', 'results', 'outline-projection.json'), 'utf8'));
const projPass = {};
for (const r of PROJ) if (r.passed && !r.outline.startsWith('대조')) (projPass[r.outline] ??= []).push(r.bedrooms);
const thumb = (m) => {
  const runs = [];
  for (let j = 0; j < m.ny; j++)
    for (let i = 0, s = -1; i <= m.nx; i++) {
      const on = i < m.nx && m.cells[j * m.nx + i];
      if (on && s < 0) s = i;
      if (!on && s >= 0) (runs.push(`M${s} ${j}h${i - s}v1h${s - i}z`), (s = -1));
    }
  return `<svg viewBox="-2 -2 ${m.nx + 4} ${m.ny + 6}" class="gen-shape-svg" aria-hidden="true"><path d="${runs.join('')}" fill="#e9d3a6" shape-rendering="crispEdges"/><path d="M0 ${m.ny + 2}h${m.nx}" stroke="#e8590c" stroke-width="0.8"/></svg>`;
};
const shapes = [
  { id: 'rect', label: '직사각형', sub: '판상형 띠 배치(QUBO + SA)', note: '지금까지의 생성 방식', svg: thumb({ nx: 40, ny: 26, cells: new Uint8Array(40 * 26).fill(1) }) },
  ...OUTL.outlines.map((o) => ({
    id: o.id,
    label: `형태 ${o.id.slice(1)}`,
    sub: `${o.n.toLocaleString()}세대 · ${(o.share * 100).toFixed(1)}%`,
    note: projPass[o.id] ? `QUBO + SA: 침실 ${projPass[o.id].join('·')}개 · 그 밖은 자유형 엔진` : '자유형 엔진(정확 QUBO 범위 밖)',
    svg: thumb(largest(maskFromUnit(o.rep, 84))),
  })),
];

const steps = [
  { key: 'shape', title: '외곽 형태', q: '외곽 형태 선택: AI 허브 아파트 평면도의 세대 외곽' },
  { key: 'area', title: '전용면적', q: '전용면적 선택' },
  { key: 'living', title: '거실 면적', q: '거실 면적 비율(전용면적 대비)' },
  { key: 'bedrooms', title: '침실 수', q: '침실 수' },
  { key: 'roomSize', title: '침실 면적', q: '침실 면적(작은방 면적 비율, 안방 비중)' },
  { key: 'composition', title: '실 구성', q: '실 구성(복수 선택)' },
  { key: 'syntax', title: '공간구문 조건', q: '공간구문 조건: 동선과 공간 위계(복수 선택)' },
  { key: 'lifestyle', title: '생활 조건', q: '생활 조건(복수 선택)' },
  { key: 'result', title: '최적 도면', q: '조건에 맞춰 만든 평면과 그 평면이 만들어지는 과정입니다.' },
];
---

<Base title="도면 생성 · 평면 생성 랩" description="전용면적·거실·침실·실 구성과 공간구문·생활 조건을 선택하면 판상형 아파트 평면을 만들고, 만들어지는 과정을 단계별로 보여 줍니다.">
  <Topbar current="generate" />

  <section class="hero hero-compact">
    <p class="eyebrow">조건 → 생성 → 적합성으로 최적화</p>
    <h1>도면 <span class="gradient-text">생성하기</span></h1>
    <p class="lede">
      외곽 형태(직사각형 또는 AI 허브 세대 외곽)를 먼저 고르고 전용면적부터 생활 조건까지 차례로 선택하면 아파트 평면을 여러 개 만들어 조건에 가장 잘 맞는 안을 고르고, 그 평면이 전용면적 사각형에서 문·창·설비까지 어떻게 만들어지는지 단계별로 보여 줍니다.
      크기·개수·구성 선택지는 AI 허브 SPA 라벨 전체({src.files.toLocaleString()}건)의 아파트 평면도(APT_FP) {src.units.toLocaleString()}세대에서, 공간구문·생활 조건은 공간구문 변수·규칙과 그 근거 논문에서 가져왔습니다.
    </p>
  </section>

  <main class="gen" id="gen">
    <ol class="gen-steps" aria-label="단계">
      {steps.map((s, i) => (
        <li>
          <button type="button" data-goto={i} aria-current={i === 0 ? 'step' : undefined} disabled={i > 0}>
            <span class="gen-num">{i + 1}</span>
            <span>{s.title}</span>
          </button>
        </li>
      ))}
    </ol>

    <div class="gen-body">
      <form class="gen-panel" id="gen-form" novalidate>
        <!-- 0. 외곽 형태 -->
        <div class="gen-step" data-step="0">
          <h2>{steps[0].q}</h2>
          <div class="gen-options gen-shapes" data-group="shape">
            {shapes.map((o) => (
              <label class="gen-opt"><input type="radio" name="shape" value={o.id} checked={o.id === 'rect'} />
                <Fragment set:html={o.svg} />
                <strong>{o.label}</strong>
                <span>{o.sub}</span>
                <span class="gen-opt-note">{o.note}</span>
              </label>
            ))}
          </div>
          <p class="note">아파트 평면도 고유 세대 {OUTL.total.toLocaleString()}개의 실내 외곽(발코니가 아래·앞에 오게 돌림)을 외곽 상자 12×12 칸 채움 비율로 묶은 {OUTL.outlines.length}개 형태입니다(k-means, 외곽이 한 덩어리가 아닌 세대는 세대 분리 오류로 보고 뺌). 그림은 묶음 중심에 가장 가까운 세대의 외곽, 주황 선은 앞(발코니) 쪽입니다. <b>QUBO + SA</b>로 표시된 형태·침실 수는 정확 QUBO 배치를 그 외곽에 잘라 넣어도 모든 배치에서 실이 사라지거나 쪼개지지 않고 공간구문 그래프가 그대로임을 확인한 조합(외곽 투영 검증, 34개 중 15개 통과)이라 직사각형과 같은 생성기로 만들고 외곽에 맞춰 자릅니다. 그 밖의 조합은 정확 QUBO 범위 밖이라 칸 담금질(자유형 엔진, QUBO 아님)로 만듭니다.</p>
        </div>

        <!-- 1. 평수 -->
        <div class="gen-step" data-step="1" hidden>
          <h2>{steps[1].q}</h2>
          <div class="gen-options" data-group="area">
            {choices.area.map((o) => (
              <label class="gen-opt"><input type="radio" name="area" value={o.value} data-bedrooms={o.bedrooms} checked={o.value === 84} />
                <strong>{o.label}</strong>
                <span>{o.sub}</span>
                {o.note && <span class="gen-opt-note">{o.note}</span>}
              </label>
            ))}
          </div>
          <p class="note">라벨에는 실제 치수(축척)가 없어 면적은 라벨에서 정하지 못합니다. 국민주택 규모(85㎡) 안팎의 대표 주택형을 선택지로 두고, 실 크기는 아래 단계에서 라벨의 면적비로 나눕니다.</p>
        </div>

        <!-- 2. 거실 크기 -->
        <div class="gen-step" data-step="2" hidden>
          <h2>{steps[2].q}</h2>
          <div class="gen-options" data-group="living">
            {choices.living.map((o) => (
              <label class="gen-opt"><input type="radio" name="living" value={o.key} data-share={o.share} checked={o.key === 'standard'} />
                <strong>{o.label}</strong>
                <span class="gen-m2" data-share-m2={o.share}></span>
                <span>{o.sub}</span>
              </label>
            ))}
          </div>
          <p class="note">아파트 평면도 {src.units.toLocaleString()}세대에서 전용면적(발코니·실외기실 제외) 대비 거실 면적비의 분위수입니다(침실 수별 차이가 작아 전체로 잡음).</p>
        </div>

        <!-- 3. 방 개수 -->
        <div class="gen-step" data-step="3" hidden>
          <h2>{steps[3].q}</h2>
          <div class="gen-options" data-group="bedrooms">
            {choices.bedrooms.map((o) => (
              <label class="gen-opt"><input type="radio" name="bedrooms" value={o.value} checked={o.value === 3} />
                <strong>{o.label}</strong>
                <span>{o.sub}</span>
              </label>
            ))}
          </div>
          <p class="note">아파트 평면도 세대의 침실 수 분포입니다(6개 이상은 판상형 한 줄에 들어가지 않아 뺌). 전용면적을 선택하면 그 주택형에서 흔한 개수가 먼저 선택됩니다.</p>
        </div>

        <!-- 4. 방 크기 -->
        <div class="gen-step" data-step="4" hidden>
          <h2>{steps[4].q}</h2>
          <h3 class="gen-sub">작은방 크기</h3>
          <div class="gen-options" data-group="roomSize">
            {choices.roomSize.map((o) => (
              <label class="gen-opt"><input type="radio" name="roomSize" value={o.key} data-share={o.share} checked={o.key === 'standard'} />
                <strong>{o.label}</strong>
                <span class="gen-m2" data-share-m2={o.share}></span>
                <span>{o.sub}</span>
              </label>
            ))}
          </div>
          <h3 class="gen-sub">안방 비중</h3>
          <div class="gen-options" data-group="master">
            {choices.master.map((o) => (
              <label class="gen-opt"><input type="radio" name="master" value={o.key} data-ratio={o.ratio} checked={o.key === 'standard'} />
                <strong>{o.label}</strong>
                <span>{o.sub}</span>
              </label>
            ))}
          </div>
          <p class="note">작은방은 전용 대비 면적비, 안방은 '안방/다른 침실 면적비'(Zeng et al. 2025)의 분위수이며, 고른 침실 수의 세대만으로 계산합니다(방이 많을수록 작은방이 작아짐).</p>
        </div>

        <!-- 5. 방 구성 -->
        <div class="gen-step" data-step="5" hidden>
          <h2>{steps[5].q}</h2>
          <div class="gen-options gen-multi" data-group="composition" data-multi>
            {choices.composition.map((o) => (
              <label class="gen-opt"><input type="checkbox" name="composition" value={o.key} checked={o.default} />
                <strong>{o.label}</strong>
                <span>{o.sub}</span>
              </label>
            ))}
          </div>
          <p class="note">비율은 아파트 평면도 {src.units.toLocaleString()}세대 가운데 그 실이 있는 세대의 비율입니다. 현관·거실·주방·침실·화장실은 필수 실이라 항상 넣습니다. 침실 수를 고르면 그 침실 수 세대의 절반 이상이 가진 실이 먼저 켜집니다. 화장실 3개는 침실 쪽에 욕실3을 하나 더 둡니다(4개 이상은 고유 세대의 6%라 지원하지 않음).</p>
        </div>

        <!-- 6. 공간구문 -->
        <div class="gen-step" data-step="6" hidden>
          <h2>{steps[6].q}</h2>
          <div class="gen-options gen-multi gen-wide" data-group="syntax" data-multi>
            {SYNTAX_CHOICES.map((c) => (
              <label class="gen-opt"><input type="checkbox" name="syntax" value={c.key} checked={c.key === 'livingCentral'} />
                <strong>{c.title}</strong>
                <span>{c.desc}</span>
                <span class="gen-metrics">지표: {c.metrics.join(' · ')}</span>
                <span class="cites">{c.refs.map((id) => <a class="cite" href={refOf[id].url} target="_blank" rel="noopener">{refOf[id].short}</a>)}</span>
              </label>
            ))}
          </div>
          <p class="note">문 정보가 없는 인접 그래프에서 계산하는 공간구문 변수·규칙입니다. 고른 항목은 최적화 목적함수에 더해지고, 변수의 목표 범위는 실제 아파트 평면도 분포(하위 10% ~ 상위 10%)로 정했습니다.</p>
        </div>

        <!-- 7. 생활 조건 -->
        <div class="gen-step" data-step="7" hidden>
          <h2>{steps[7].q}</h2>
          <div class="gen-options gen-multi gen-wide" data-group="lifestyle" data-multi>
            {LIFESTYLE_CHOICES.map((c) => (
              <label class="gen-opt"><input type="checkbox" name="lifestyle" value={c.key} />
                <strong>{c.title}</strong>
                <span>{c.desc}</span>
                <span class="gen-metrics">지표: {c.metrics.join(' · ')}{c.effect && ` · 조건: ${c.effect}`}</span>
                {c.refs.length > 0 && <span class="cites">{c.refs.map((id) => <a class="cite" href={refOf[id].url} target="_blank" rel="noopener">{refOf[id].short}</a>)}</span>}
                {c.note && <span class="gen-opt-note">{c.note}</span>}
              </label>
            ))}
          </div>
        </div>

        <!-- 8. 결과 -->
        <div class="gen-step" data-step="8" hidden>
          <h2>{steps[8].q}</h2>
          <fieldset class="gen-algos" id="gen-algos">
            <legend>생성 알고리즘</legend>
            <p class="note">
              생성기는 <b>QUBO + SA</b>입니다. 방 배치(앞·뒤 띠의 방 순서)의 공간구문 값 5개 — 거실·현관·주방의 상대 깊이(RRA), 공·사 깊이 차, 현관→거실 깊이 — 를
              AI 허브 아파트 평면 7,275장의 실제 평균에 맞춘 최대 엔트로피 모형의 에너지 E = Σ β·f로 묶고, 이 에너지를 <b>정확한 QUBO</b>(배치 원-핫·맞닿음·복도 존재·깊이 구조·최단 깊이 하한 제약, 벌점 P = Σ|계수| + 1)로 써서
              <b>SA</b>(dwave-samplers 규칙: 기하 β 스케줄, 스위프 1,000, 무작위 초기 상태)로 고른 시간 동안 읽기를 반복합니다. 유효한(제약을 지킨) 읽기 가운데 에너지가 낮은 배치부터 치수를 다듬어 평면으로 만들고,
              필수 규칙·최소 실 폭·문 동선 점검을 통과한 서로 다른 3안을 에너지 순으로 보여 줍니다. 같은 조건의 배치를 전부 열거한 최저 E*는 SA가 최적에 닿았는지 확인하는 데만 씁니다(생성에는 쓰지 않음).
              배치 틀은 QUBO 칸 모형의 맞닿음이 도면과 그대로 맞는 정렬 모드(복도 포함)입니다. 침실 1개·5개는 모형을 맞춘 실제 데이터(침실 2~4개) 밖이라 손 가중치 QUBO + SA로 만듭니다.
              근거: Lucas 2014(QUBO 정식화), Kirkpatrick et al. 1983(SA), Jaynes 1957·Park &amp; Newman 2004(최대 엔트로피), Hillier &amp; Hanson 1984(볼록 공간). 고정 기록: Confluence 09-21.
            </p>
            <div class="gen-algo-list">
              {algos.map((a) => (
                <label class="gen-algo">
                  <input type="checkbox" name="algo" value={a.key} checked disabled />
                  <span>
                    <strong>{a.name}</strong>
                    <span class="note">{a.family}{a.cite && a.cite !== '—' ? ` · ${a.cite}` : ''}</span>
                  </span>
                </label>
              ))}
            </div>
            <div class="gen-algo-actions">
              <div class="seg gen-tabs gen-budget-tabs" role="tablist" id="gen-budget-tabs" aria-label="SA 계산 시간">
                <button type="button" data-ms="30000" aria-pressed="true">30초<small></small></button>
                <button type="button" data-ms="60000" aria-pressed="false">1분<small></small></button>
                <button type="button" data-ms="180000" aria-pressed="false">3분<small></small></button>
              </div>
              <label class="gen-inline">시드 <input type="number" id="gen-seed" value="1" min="1" max="9999" /></label>
              <button type="button" class="button-primary" id="gen-run">SA로 다시 생성</button>
              <button type="button" class="button-ghost small" id="gen-qubo">정확 QUBO 내보내기(D-Wave·Gurobi용)</button>
            </div>
            <p class="note"><b>계산 시간</b>은 SA가 읽기를 반복하는 시간입니다. 탭마다 결과를 따로 기억하므로 30초·1분·3분을 번갈아 보며 비교할 수 있고, 같은 탭에서 "SA로 다시 생성"을 누르면 그 시간으로 다시 돕니다(시드를 바꾸면 다른 무작위 경로). 결과 아래에 읽기마다의 에너지와 E* 도달 여부를 그립니다.</p>
            <details class="pl-what gen-qw" id="gen-qw" open>
