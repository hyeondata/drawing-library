---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import { REFERENCES } from '../model/config.js';
import { buildChoices } from '../generate/choices.js';
import { LIFESTYLE_CHOICES, SYNTAX_CHOICES } from '../generate/preferences.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const dir = path.join(process.cwd(), 'public', 'data', 'labels');
const files = fs.readdirSync(dir);
const read = (f) => JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8'));
const choices = buildChoices({
  spaLabels: files.filter((f) => f.includes('_SPA_')).map((f) => ({ id: f.replace(/\.json$/, ''), label: read(f) })),
  ocrLabels: files.filter((f) => f.includes('_OCR_')).map(read),
});
const refOf = Object.fromEntries(REFERENCES.map((r) => [r.id, { short: r.short, url: r.url, index: r.index }]));
const strip = (c) => ({ key: c.key, short: c.short, title: c.title, desc: c.desc, metrics: c.metrics, refs: c.refs, note: c.note || null, effect: c.effect || null });
const src = choices.source;

const steps = [
  { key: 'area', title: '평수', q: '전용면적을 고르세요.' },
  { key: 'living', title: '거실 크기', q: '거실을 얼마나 넓게 할까요?' },
  { key: 'bedrooms', title: '방 개수', q: '침실은 몇 개가 필요하세요?' },
  { key: 'roomSize', title: '방 크기', q: '작은방 크기와 안방 비중을 고르세요.' },
  { key: 'composition', title: '방 구성', q: '넣을 실을 고르세요(여러 개).' },
  { key: 'syntax', title: '공간구문', q: '동선과 공간 위계를 어떻게 할까요(여러 개)?' },
  { key: 'lifestyle', title: '생활 선호', q: '어떤 집이 좋으세요(여러 개)?' },
  { key: 'result', title: '최적 도면', q: '조건에 맞춰 평면을 만들고 평가 모델로 고른 결과입니다.' },
];
---

<Base title="도면 생성 · 평면 평가 랩" description="평수·거실·방·구성과 공간구문·생활 선호를 고르면 평가 모델로 최적화한 아파트 평면을 만듭니다.">
  <Topbar current="generate" />

  <section class="hero hero-compact">
    <p class="eyebrow">조건 → 생성 → 모델로 최적화</p>
    <h1>도면 <span class="gradient-text">생성하기</span></h1>
    <p class="lede">
      평수부터 생활 선호까지 차례로 고르면 판상형 아파트 평면을 수백 개 만들고, 평가 모델 점수와 고른 조건에 가장 잘 맞는 안을 골라 보여 줍니다.
      크기·개수·구성 선택지는 AI 허브 라벨(SPA {src.units}세대 · OCR {src.ocrDrawings}장)에서, 공간구문·생활 선호는 평가 지표와 그 근거 논문에서 가져왔습니다.
    </p>
  </section>

  <main class="gen" id="gen">
    <ol class="gen-steps" aria-label="단계">
      {steps.map((s, i) => (
        <li>
          <button type="button" data-goto={i} aria-current={i === 0 ? 'step' : undefined} disabled={i > 0}>
            <span class="gen-num">{i + 1}</span>
            <span>{s.title}</span>
          </button>
        </li>
      ))}
    </ol>

    <div class="gen-body">
      <form class="gen-panel" id="gen-form" novalidate>
        <!-- 1. 평수 -->
        <div class="gen-step" data-step="0">
          <h2>{steps[0].q}</h2>
          <div class="gen-options" data-group="area">
            {choices.area.map((o) => (
              <label class="gen-opt"><input type="radio" name="area" value={o.value} data-bedrooms={o.bedrooms} checked={o.value === 84} />
                <strong>{o.label}</strong>
                <span>{o.sub}</span>
                {o.note && <span class="gen-opt-note">{o.note}</span>}
              </label>
            ))}
          </div>
          <p class="note">라벨에는 실제 치수(축척)가 없어 면적은 라벨에서 정하지 못합니다. 국민주택 규모(85㎡) 안팎의 대표 주택형을 선택지로 두고, 실 크기는 아래 단계에서 라벨의 면적비로 나눕니다.</p>
        </div>

        <!-- 2. 거실 크기 -->
        <div class="gen-step" data-step="1" hidden>
          <h2>{steps[1].q}</h2>
          <div class="gen-options" data-group="living">
            {choices.living.map((o) => (
              <label class="gen-opt"><input type="radio" name="living" value={o.key} data-share={o.share} checked={o.key === 'standard'} />
                <strong>{o.label}</strong>
                <span class="gen-m2" data-share-m2={o.share}></span>
                <span>{o.sub}</span>
              </label>
            ))}
          </div>
          <p class="note">기준 {src.units}세대 SPA 라벨에서 전용면적(발코니·실외기실 제외) 대비 거실 면적비의 분위수입니다.</p>
        </div>

        <!-- 3. 방 개수 -->
        <div class="gen-step" data-step="2" hidden>
          <h2>{steps[2].q}</h2>
          <div class="gen-options" data-group="bedrooms">
            {choices.bedrooms.map((o) => (
              <label class="gen-opt"><input type="radio" name="bedrooms" value={o.value} checked={o.value === 3} />
                <strong>{o.label}</strong>
                <span>{o.sub}</span>
              </label>
            ))}
          </div>
          <p class="note">기준 세대의 침실 수 분포입니다. 평수를 고르면 그 주택형에서 흔한 개수가 먼저 선택됩니다.</p>
        </div>

        <!-- 4. 방 크기 -->
        <div class="gen-step" data-step="3" hidden>
          <h2>{steps[3].q}</h2>
          <h3 class="gen-sub">작은방 크기</h3>
          <div class="gen-options" data-group="roomSize">
            {choices.roomSize.map((o) => (
              <label class="gen-opt"><input type="radio" name="roomSize" value={o.key} data-share={o.share} checked={o.key === 'standard'} />
                <strong>{o.label}</strong>
                <span class="gen-m2" data-share-m2={o.share}></span>
                <span>{o.sub}</span>
              </label>
            ))}
          </div>
          <h3 class="gen-sub">안방 비중</h3>
          <div class="gen-options" data-group="master">
            {choices.master.map((o) => (
              <label class="gen-opt"><input type="radio" name="master" value={o.key} data-ratio={o.ratio} checked={o.key === 'standard'} />
                <strong>{o.label}</strong>
                <span>{o.sub}</span>
              </label>
            ))}
          </div>
          <p class="note">작은방은 전용 대비 면적비, 안방은 '안방/다른 침실 면적비'(평가 지표, Zeng et al. 2025)의 분위수입니다.</p>
        </div>

        <!-- 5. 방 구성 -->
        <div class="gen-step" data-step="4" hidden>
          <h2>{steps[4].q}</h2>
          <div class="gen-options gen-multi" data-group="composition" data-multi>
            {choices.composition.map((o) => (
              <label class="gen-opt"><input type="checkbox" name="composition" value={o.key} checked={o.default} />
                <strong>{o.label}</strong>
                <span>{o.sub}</span>
              </label>
            ))}
          </div>
          <p class="note">'SPA n/{src.units}세대'는 그 실이 있는 기준 세대 수, 'OCR n장'은 그 실 이름이 적힌 OCR 라벨 도면 수입니다. 현관·거실·주방·침실·화장실은 필수 실이라 항상 넣습니다.</p>
        </div>

        <!-- 6. 공간구문 -->
        <div class="gen-step" data-step="5" hidden>
          <h2>{steps[5].q}</h2>
          <div class="gen-options gen-multi gen-wide" data-group="syntax" data-multi>
            {SYNTAX_CHOICES.map((c) => (
              <label class="gen-opt"><input type="checkbox" name="syntax" value={c.key} checked={c.key === 'livingCentral'} />
                <strong>{c.title}</strong>
                <span>{c.desc}</span>
                <span class="gen-metrics">지표: {c.metrics.join(' · ')}</span>
                <span class="cites">{c.refs.map((id) => <a class="cite" href={refOf[id].url} target="_blank" rel="noopener">{refOf[id].short}</a>)}</span>
              </label>
            ))}
          </div>
          <p class="note">문 정보가 없는 인접 그래프에서 계산하는 평가 모델의 공간구문 지표·규칙입니다. 고른 항목은 최적화 목적함수에 더해집니다.</p>
        </div>

        <!-- 7. 생활 선호 -->
        <div class="gen-step" data-step="6" hidden>
          <h2>{steps[6].q}</h2>
          <div class="gen-options gen-multi gen-wide" data-group="lifestyle" data-multi>
            {LIFESTYLE_CHOICES.map((c) => (
              <label class="gen-opt"><input type="checkbox" name="lifestyle" value={c.key} />
                <strong>{c.title}</strong>
                <span>{c.desc}</span>
                <span class="gen-metrics">지표: {c.metrics.join(' · ')}{c.effect && ` · 조건: ${c.effect}`}</span>
                {c.refs.length > 0 && <span class="cites">{c.refs.map((id) => <a class="cite" href={refOf[id].url} target="_blank" rel="noopener">{refOf[id].short}</a>)}</span>}
                {c.note && <span class="gen-opt-note">{c.note}</span>}
              </label>
            ))}
          </div>
        </div>

        <!-- 8. 결과 -->
        <div class="gen-step" data-step="7" hidden>
          <h2>{steps[7].q}</h2>
          <div class="gen-progress" id="gen-progress" hidden>
            <div class="gen-bar"><i id="gen-bar"></i></div>
            <p class="note" id="gen-progress-text">평면을 만드는 중…</p>
          </div>
          <div id="gen-result" hidden>
            <div class="seg gen-tabs" role="tablist" id="gen-tabs"></div>
            <div class="gen-result">
              <figure class="gen-plan" id="gen-plan"></figure>
              <div class="gen-detail" id="gen-detail"></div>
            </div>
            <div class="gen-actions">
              <button type="button" class="button-primary" id="gen-open">평가 화면에서 자세히 보기 →</button>
              <button type="button" class="button-ghost small" id="gen-more">다른 안 더 만들기</button>
              <button type="button" class="button-ghost small" id="gen-json">라벨 JSON</button>
              <button type="button" class="button-ghost small" id="gen-svg">SVG</button>
            </div>
          </div>
          <details class="gen-method">
            <summary>어떻게 만들고 고르나요?</summary>
            <ol>
              <li><b>생성</b>: 앞(남측) 띠에 거실과 침실을, 뒤 띠에 주방·현관·화장실·드레스룸을 두는 판상형 배치로 평면을 만듭니다(한국 평면의 거실 중심 배치, Seo 2007; Choi et al. 2014). 안방 뒤에는 부부욕실·드레스룸을 붙이고, 얕은 침실 뒤는 복도로 씁니다. 깊이, 실 순서, 위아래 쌓기, 면적 배분을 바꿔 가며 수백 개를 만듭니다.</li>
              <li><b>평가</b>: 각 안을 AI 허브 SPA 라벨 형식으로 바꿔 이 사이트의 평가 모델(v0.3.0)로 채점합니다.</li>
              <li><b>선택</b>: 목적함수 = 모델 점수 45% + 목표 면적 부합 25% + 고른 선호 점수 평균 30%(선호를 고르지 않으면 모델·부합만). 유효하지 않은 평면과 너무 좁은 실(욕실 1.5m, 침실 2.4m, 안방 3.0m, 거실 3.6m 미만, 거실·침실 종횡비 2 초과)은 감점합니다. 무작위 탐색 뒤 상위 안을 국소 탐색으로 다듬고, 배치가 서로 다른 3안을 보여 줍니다.</li>
            </ol>
            <p class="note">한계: 실은 직사각형이고 벽 두께·문·창은 그리지 않습니다. 기준이 35세대뿐이라 모델 점수는 '이 표본과 얼마나 닮았나'입니다. 방음은 배치로 줄일 수 있는 부분(소음원과 맞댄 침실 벽)만 근사합니다. 설계 검토 전 단계의 배치 아이디어로 써 주세요.</p>
          </details>
        </div>

        <div class="gen-nav">
          <button type="button" class="button-ghost small" id="gen-prev" disabled>← 이전</button>
          <p class="gen-summary" id="gen-summary"></p>
          <button type="button" class="button-primary" id="gen-next">다음 →</button>
        </div>
      </form>
    </div>
  </main>

  <footer class="footer">
    <span>평면 평가 랩 · 도면 생성</span>
    <span>생성·평가는 브라우저 안에서 합니다</span>
  </footer>

  <script
    id="gen-data"
    type="application/json"
    set:html={JSON.stringify({
      base,
      steps,
      targets: choices.targets,
      living: choices.living,
      refs: refOf,
      syntax: SYNTAX_CHOICES.map(strip),
      lifestyle: LIFESTYLE_CHOICES.map(strip),
    })}
  />
  <script>
    import '../scripts/generate.js';
  </script>
</Base>
