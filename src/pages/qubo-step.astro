---
// QUBO 따라가기: 조건을 고르면 QUBO가 만들어지는 과정을 단계마다 실제 코드와 실제 숫자로 보여 준다.
// 숫자는 모두 브라우저에서 실제 생성 코드(qubo.js·layout.js·optimize.js·solvers.js)를 돌려 얻고,
// 단계마다 '확인'에서 따로 계산한 값과 코드의 값이 같은지 검사한다.
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import { show, showSeg } from '../lib/source.js';
import { ALL_CHOICES } from '../generate/preferences.js';
import { badges } from '../generate/pipeline.js';
import Pipeline from '../components/Pipeline.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const Q = 'src/generate/qubo.js';
const L = 'src/generate/layout.js';

const steps = [
  {
    kinds: ['rule'], id: 'program', n: 1, title: '실 프로그램: 어떤 실이 몇 ㎡인가',
    goal: '배치를 정하기 전에, 어떤 실을 얼마만큼 둘지부터 정합니다. 이 면적은 QUBO 변수가 아니라 고정된 입력입니다.',
    eq: 'a<sub>r</sub>′ = max(최소 면적<sub>r</sub>, t<sub>r</sub> · A) &nbsp;→&nbsp; a<sub>r</sub> = a<sub>r</sub>′ · A / Σ<sub>s</sub> a<sub>s</sub>′',
    note: 'A = 전용면적, t<sub>r</sub> = AI 허브 아파트 평면도 전체에서 고른 침실 수 세대의 실별 면적 비율(중앙값). 최소 면적을 지키게 올린 뒤, 합이 다시 A가 되도록 모두 같은 비율로 맞춥니다.',
    code: show(L, 'programOf'),
  },
  {
    kinds: ['rule'], id: 'bands', n: 2, title: '띠 나누기: 앞 띠에 침실을 몇 개 두나',
    goal: '판상형 평면은 앞(남측) 띠와 뒤(북측) 띠로 나뉩니다. 앞 띠에는 거실·안방과 작은방 몇 개가 들어가는데, 그 수는 앞 띠 폭에 최소 폭이 몇 개 들어가는지로 정합니다.',
    eq: 'W ≈ A / (7.0 · (A/84)<sup>0.3</sup>),&nbsp;&nbsp; k = 가장 큰 정수 (k ≤ 침실 수 − 1) such that 3.0 + 3.6 + 2.6·k ≤ W',
    note: '3.0 = 안방, 3.6 = 거실, 2.6 = 작은방의 최소 폭(m). 생성기는 k개와 k − 1개 두 가지(템플릿)를 따로 풀고 더 좋은 쪽을 고릅니다. 아래에서 템플릿을 바꿔 볼 수 있습니다.',
    code: show(Q, 'frontBedCount') + showSeg(Q, 'const others = program.filter', 'const k = backRooms.length;'),
  },
  {
    kinds: ['qubo'], id: 'vars', n: 3, title: '변수 만들기: x(실, 칸)',
    goal: '"어느 실이 어느 칸에 가는가"를 0/1 변수로 씁니다. 앞 띠의 실은 앞 띠 칸에만, 뒤 띠의 실은 뒤 띠 칸에만 변수를 둡니다.',
    eq: 'x<sub>r,s</sub> = 1 ⇔ 실 r이 칸 s에 놓임,&nbsp;&nbsp; 변수 수 n = m² + k² (m = 앞 띠 실 수 = 앞 칸 수, k = 뒤 띠 실 수 = 뒤 칸 수)',
    note: '부부욕실·드레스룸은 항상 안방 뒤에 붙으므로 변수에서 뺍니다. 변수 번호 i는 아래 표의 순서이고, 이후 모든 행렬의 행·열 번호가 이 i입니다.',
    code: showSeg(Q, 'const vars = [];', 'const n = vars.length;'),
  },
  {
    kinds: ['qubo'], id: 'geom', n: 4, title: '칸의 기하: 앞 칸과 뒤 칸이 얼마나 맞닿나',
    goal: '실 사이 "맞닿음"을 이진 변수로 옮기려면 칸끼리 얼마나 닿는지가 필요합니다. 띠 폭을 1로 두고 앞 칸 i는 [i/m, (i+1)/m], 뒤 칸 j는 [j/k, (j+1)/k]로 봅니다.',
    eq: 'ov(i, j) = max(0, min((i+1)/m, (j+1)/k) − max(i/m, j/k)) / min(1/m, 1/k) &nbsp;∈ [0, 1]',
    note: '겹친 길이를 짧은 칸 폭으로 나눈 값입니다. 1이면 짧은 칸이 통째로 맞닿음, 0이면 닿지 않음. 같은 띠 안에서는 칸 번호가 1 차이일 때 "옆 칸"(값 1)입니다.',
    code: showSeg(Q, '// 칸의 기하', 'const isEnd'),
  },
  {
    kinds: ['qubo'], id: 'terms', n: 5, title: '항 만들기: 단위 기여 φ<sub>t</sub>(x)',
    goal: '설계 규칙 하나(예: "주방은 거실 뒤에 닿으면 좋다")를 항 t 하나로 씁니다. 항마다 어떤 변수(일차) 또는 변수 쌍(이차)에 얼마의 계수를 주는지가 "단위 기여"입니다. 아직 가중치는 곱하지 않습니다.',
    eq: 'φ<sub>t</sub>(x) = Σ<sub>i</sub> u<sub>t,i</sub> x<sub>i</sub> + Σ<sub>i&lt;j</sub> u<sub>t,ij</sub> x<sub>i</sub> x<sub>j</sub>',
    note: '앞뒤로 닿는 규칙(vertical)은 u = ov(i, j), 옆 칸 규칙(beside)은 u = 1, 위치 규칙(at)은 일차 항 u = f(칸 위치). 같은 변수 쌍에 여러 규칙이 걸리면 항별로 따로 모아 둡니다(가중치를 따로 곱하려고).',
    code: showSeg(Q, "vertical('kitchenLiving'", "at('kitchenEnd'"),
  },
  {
    kinds: ['qubo'], id: 'weights', n: 6, title: '가중치: 손 → 공간구문 대리 항 → 선호 배수',
    goal: '항마다 얼마나 중요한지를 가중치 w<sub>t</sub>로 정합니다. 이 사이트의 "개선"은 이 가중치를 세 단계로 바꿔 온 과정입니다. 아래 표에서 항마다 단계별 값을 볼 수 있습니다.',
    eq: 'w<sub>t</sub> = w<sub>손,t</sub> + λ · s · v<sub>t</sub>,&nbsp;&nbsp; s = ‖w<sub>손</sub>‖₁ / ‖v‖₁,&nbsp;&nbsp; 실제 계수 = w<sub>t</sub> · b<sub>t</sub>',
    note: '① 손 가중치: 시공 가능성 규칙·문헌을 보고 정한 값(점수에 맞춰 다시 정하지 않음). ② 공간구문 대리 항: 공간구문 변수(SCI(E) 논문)를 φ로 회귀한 가중치 v를 λ·s배 해서 더합니다. ③ 선호 배수 b<sub>t</sub>: 그 선호를 고르면 해당 항에 곱합니다(안 고르면 1).',
    code: show(Q, 'weightsOf', 'withSyntax'),
  },
  {
    kinds: ['qubo'], id: 'matrix', n: 7, title: '행렬 조립: q<sub>ii</sub>와 q<sub>ij</sub>',
    goal: '항마다 단위 기여 × 가중치 × 선호 배수를 더해 QUBO 행렬을 만듭니다. 대각 q<sub>ii</sub>는 일차 계수, 비대각 q<sub>ij</sub>는 이차 계수입니다.',
    eq: 'q<sub>ii</sub> = Σ<sub>t</sub> w<sub>t</sub> b<sub>t</sub> u<sub>t,i</sub>,&nbsp;&nbsp; q<sub>ij</sub> = Σ<sub>t</sub> w<sub>t</sub> b<sub>t</sub> u<sub>t,ij</sub>',
    note: '그림의 칸을 누르면 그 계수가 어떤 항들의 합인지 한 줄씩 보여 줍니다. 파랑 = 보상(음수, 그 배치를 원함), 주황 = 감점(양수).',
    code: showSeg(Q, '// 가중치를 곱해 합친다.', '// ---- 원-핫 벌점'),
  },
  {
    kinds: ['qubo'], id: 'penalty', n: 8, title: '제약을 벌점으로: P(Σx − 1)²와 P의 크기',
    goal: '"실마다 칸 하나, 칸마다 실 하나"는 QUBO에 제약으로 쓸 수 없으므로 벌점으로 바꿉니다. 이진 변수는 x² = x라서 제곱을 펼치면 다시 일차·이차 항이 됩니다.',
    eq: 'P(Σ<sub>i∈g</sub> x<sub>i</sub> − 1)² = P(1 − Σ<sub>i∈g</sub> x<sub>i</sub> + 2Σ<sub>a&lt;b∈g</sub> x<sub>a</sub>x<sub>b</sub>),&nbsp;&nbsp; P = ⌈1 + max<sub>i</sub>(|q<sub>ii</sub>| + Σ<sub>j</sub>|q<sub>ij</sub>|)⌉',
    note: '변수 하나는 언제나 묶음 두 개(그 실의 행, 그 칸의 열)에 들어가므로 대각에는 −P가 두 번 더해져 −2P, 같은 묶음의 쌍에는 +2P, 묶음마다 상수 P가 offset에 더해집니다. P는 목적 계수만으로 계산합니다.',
    code: showSeg(Q, '// ---- 원-핫 벌점', 'return { n, vars'),
  },
  {
    kinds: ['qubo'], id: 'proof', n: 9, title: '증명: 왜 이 P면 충분한가',
    goal: 'P가 너무 작으면 제약을 어긴 해가 최적이 될 수 있고, 너무 크면 탐색이 어려워집니다. 이 P가 "올바른 배치를 지키기에 충분하다"는 것을 단계별로 보이고, 지금 입력의 숫자로 확인합니다.',
    eq: '모든 올바른 배치 x와 모든 변수 i에 대해 &nbsp;Δ<sub>i</sub>(x) ≥ 2P − G<sub>max</sub> &gt; 0 &nbsp;&nbsp;(G<sub>max</sub> = max<sub>i</sub>(|q<sub>ii</sub>| + Σ<sub>j</sub>|q<sub>ij</sub>|), 목적 계수)',
    note: '이 정리는 "올바른 배치는 모두 한 변수 뒤집기에 대해 국소 최소"라는 뜻입니다. 전역(2ⁿ개 전체)에서 최소가 올바른 배치라는 것은 아래 "전체 확인"으로 숫자로 검사합니다.',
    code: show(Q, 'energy', 'features'),
  },
  {
    kinds: ['qubo'], id: 'debug', n: 10, title: '디버거: 배치 하나의 에너지를 한 줄씩',
    goal: '배치를 하나 골라(또는 변수 칸을 직접 눌러 켜고 끄며) 에너지를 처음부터 계산합니다. 펼친 꼴(offset + Σq<sub>ii</sub>x<sub>i</sub> + Σq<sub>ij</sub>x<sub>i</sub>x<sub>j</sub>)과 원래 꼴(Σw<sub>t</sub>b<sub>t</sub>φ<sub>t</sub> + PΣ(Σx − 1)²)이 같은 값을 내는지 확인합니다.',
    eq: 'E(x) = offset + Σ<sub>i</sub> q<sub>ii</sub> x<sub>i</sub> + Σ<sub>i&lt;j</sub> q<sub>ij</sub> x<sub>i</sub> x<sub>j</sub> &nbsp;=&nbsp; Σ<sub>t</sub> w<sub>t</sub> b<sub>t</sub> φ<sub>t</sub>(x) + P Σ<sub>g</sub> (Σ<sub>i∈g</sub> x<sub>i</sub> − 1)²',
    note: '규칙을 어기는 배치(실 하나가 두 칸, 빈 칸 등)도 만들어 벌점이 어떻게 붙는지 볼 수 있습니다.',
    code: '',
  },
  {
    kinds: ['qubo'], id: 'solve', n: 11, title: '풀기: 에너지가 가장 낮은 배치 찾기',
    goal: '올바른 배치는 앞 m! × 뒤 k!개뿐이므로 전부 계산해 가장 낮은 것(전역 최적해)을 찾습니다. 사이트의 다른 풀이기 10종은 이 값을 얼마나 빨리·자주 찾는지로 비교합니다.',
    eq: 'x* = argmin<sub>x</sub> E(x)',
    note: '표의 "디버거로" 버튼을 누르면 그 배치를 10단계에 불러와 에너지를 한 줄씩 볼 수 있습니다.',
    code: '',
  },
  {
    kinds: ['rule', 'search', 'eval'], id: 'plan', n: 12, title: '평면으로 풀기: 순서 → 방 크기 → 점수',
    goal: 'QUBO는 순서만 정합니다. 그 순서로 방 폭·깊이를 식으로 계산해 평면을 만들고, 적합성 J(규칙 충족·면적 부합·선호)를 잽니다. 실제 생성기는 기본 치수로 한 번 만든 뒤, 치수 변수(깊이 D·앞 띠 비율 f·작은방 폭 w·안방 깊이 g)를 30번 조금씩 바꿔 J가 가장 높은 것을 고릅니다. 아래에 두 결과를 나란히 보여 줍니다.',
    eq: 'w<sub>i</sub> = m<sub>i</sub> + (W − Σm) · max(0, d<sub>i</sub> − m<sub>i</sub>) / Σ<sub>j</sub> max(0, d<sub>j</sub> − m<sub>j</sub>),&nbsp;&nbsp; J = 0.45·모델 + 0.25·면적 부합 + 0.30·선호 − 40·[무효] − 15·(좁은 실 + 문 동선 문제)',
    note: 'd<sub>i</sub> = 실 면적 ÷ 깊이(원하는 폭), m<sub>i</sub> = 최소 폭. 띠 폭 W가 최소 폭 합보다 좁으면 최소 폭에 비례해 모두 줄입니다(좁은 실 감점). 선호를 하나도 안 고르면 0.45/0.70·모델 + 0.25/0.70·면적 부합.',
    code: show(L, 'allocate') + show('src/generate/optimize.js', 'scoreLayout'),
  },
  {
    kinds: ['qubo', 'search', 'eval'], id: 'improve', n: 13, title: '개선은 어떻게 했나: 같은 입력, 세 가지 가중치',
    goal: '같은 입력에서 가중치만 ① 손 → ② 손 + 공간구문 대리 항으로 바꿔, 전역 최적해 배치와 그 평면의 J가 어떻게 달라지는지 바로 비교합니다.',
    eq: '가중치 세트마다: x* = argmin E<sub>w</sub>(x) → 평면 → J(x*)',
    note: '공간구문 대리 항은 공간구문 변수를 올리는 대신 J(면적 부합·다른 선호)를 조금 깎을 수 있습니다(evidence/results/syntax-surrogate.md).',
    code: '',
  },
];
---

<Base title="QUBO 따라가기 · 평면 생성 랩" description="조건을 고르면 QUBO가 만들어지는 과정을 단계마다 실제 코드와 실제 숫자로 따라가고, 식이 맞는지 숫자로 확인합니다.">
  <Topbar current="qubo" />
  <main class="page cd-page qs-page">
    <p class="eyebrow">QUBO · 단계별 · 디버깅</p>
    <h1>QUBO 따라가기</h1>
    <p class="lede">조건을 고르면 실제 생성 코드가 QUBO를 만듭니다. 아래 13단계는 그 과정을 순서대로 멈춰 세워, 단계마다 <b>무엇을 하려는지 → 식 → 실제 코드 → 지금 입력에서의 숫자 → 확인</b>으로 보여 줍니다. "확인"은 페이지가 식을 따로 계산한 값과 코드가 낸 값을 비교한 결과입니다.</p>

    <details class="qs-kinds">
      <summary><b>QUBO는 생성의 어느 부분인가</b> — 3~11단계(방 순서)만 QUBO이고, 1·2단계와 12단계의 방 크기·문·창은 규칙과 탐색입니다. 전체 구분 보기</summary>
      <Pipeline show="select" />
    </details>

    <section class="qs-input" id="qs-input">
      <h2>0. 입력 고르기</h2>
      <div class="qs-form">
        <label>전용면적 <select id="qs-area"><option>59</option><option>74</option><option selected>84</option><option>101</option><option>114</option><option>135</option></select> ㎡</label>
        <label>침실 <select id="qs-bed"><option>1</option><option>2</option><option selected>3</option><option>4</option><option>5</option></select></label>
        <label>화장실 <select id="qs-bath"><option value="1">1</option><option value="2" selected>2</option></select></label>
        <label><input type="checkbox" id="qs-dress" checked /> 드레스룸</label>
        <label><input type="checkbox" id="qs-multi" /> 다목적실</label>
      </div>
      <fieldset class="qs-prefs">
        <legend>선호(고르면 해당 항에 선호 배수가 곱해지고, 공간구문 선호는 대리 항이 더해집니다)</legend>
        {ALL_CHOICES.map((c) => <label><input type="checkbox" name="qs-pref" value={c.key} /> {c.short}</label>)}
      </fieldset>
      <div class="qs-form">
        <label>가중치 <select id="qs-wset"><option value="hand" selected>손으로 정한 값</option></select></label>
        <label><input type="checkbox" id="qs-sx" checked /> 공간구문 대리 항</label>
        <label>세기 λ <input type="range" id="qs-lambda" min="0" max="1" step="0.05" value="0.5" /> <b id="qs-lambda-v" class="mono">0.50</b></label>
        <label>템플릿 <select id="qs-tpl"></select></label>
      </div>
      <p class="note" id="qs-same"></p>
    </section>

    <nav class="qs-toc" aria-label="단계">
      {steps.map((s) => <a href={`#${s.id}`}>{s.n}. {s.title.replace(/<[^>]+>/g, '')}</a>)}
    </nav>

    {steps.map((s) => (
      <section class="qs-step" id={s.id}>
        <h2><span class="qs-n">{s.n}</span><span set:html={s.title} /> <Fragment set:html={badges(s.kinds)} /></h2>
        <p class="qs-goal"><b>무엇을 하나.</b> <span set:html={s.goal} /></p>
        <div class="mt-eq" set:html={s.eq} />
        <p class="note" set:html={s.note} />
        <div class="qs-live" data-live={s.id}><p class="note">계산 중…</p></div>
        {s.code && (
          <details class="cd-code">
            <summary>실제 코드 보기</summary>
            <Fragment set:html={s.code} />
          </details>
        )}
      </section>
    ))}
  </main>
  <script id="qs-data" type="application/json" set:html={JSON.stringify({ base })} />
  <script>
    import '../scripts/qubo-step.js';
  </script>
</Base>
