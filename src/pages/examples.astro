---
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import examples from '../../public/data/examples.json';
import { FIXTURE_COLORS, OCR_STYLE, ROOM_GROUPS, STR_STYLE } from '../model/drawing-style.js';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const kinds = [
  { key: 'SPA', name: '공간', desc: '실 폴리곤' },
  { key: 'STR', name: '구조', desc: '벽·문·창' },
  { key: 'OBJ', name: '설비', desc: '위생·주방 설비' },
  { key: 'OCR', name: '글자', desc: '도면 속 글자' },
];
const kindName = Object.fromEntries(kinds.map((k) => [k.key, k.name]));
const countOf = (key: string) => examples.filter((e) => e.kind === key).length;
const originals = examples.filter((e) => e.original).length;
const summary = (e: (typeof examples)[number]) =>
  e.counts
    .filter(([name]) => name !== '기타')
    .slice(0, 3)
    .map(([name, n]) => `${name} ${n}`)
    .join(' · ');

const legends = {
  SPA: ROOM_GROUPS.map((g) => ({ label: g.label, fill: g.fill, stroke: '#4a4856' })),
  STR: Object.values(STR_STYLE).map((s) => ({ label: s.label, fill: s.fill, stroke: s.stroke })),
  OBJ: Object.entries(FIXTURE_COLORS).map(([label, c]) => ({ label, fill: `${c}29`, stroke: c })),
  OCR: [{ label: '글자 상자(원래 위치·크기)', fill: `${OCR_STYLE.stroke}12`, stroke: OCR_STYLE.stroke }],
};
const sourceNote = {
  SPA: '라벨의 실 폴리곤을 실 종류별 색으로 채우고, 실 이름을 실 안쪽에 적었습니다.',
  STR: '라벨의 벽·문·창 폴리곤을 그렸습니다. 문 폴리곤은 문이 열리는 범위를 나타냅니다.',
  OBJ: '원본 PNG가 없는 도면은 설비 상자 위치를 그렸습니다.',
  OCR: '도면에 적힌 글자를 원래 자리와 크기로 다시 썼습니다.',
};
---

<Base title="예시 도면 · 평면 평가 랩" description="AI 허브 아파트 평면도 Sample 80장을 원본 이미지와 라벨로 그린 도면으로 보여 줍니다.">
  <Topbar current="examples" />

  <section class="hero hero-compact">
    <p class="eyebrow">AI 허브 건축 도면 Sample</p>
    <h1>예시 도면 <span class="gradient-text">{examples.length}장</span></h1>
    <p class="lede">
      Sample 폴더의 도면을 모두 모았습니다. 원본 PNG는 설비(OBJ) {originals}장만 있어서, 나머지 {examples.length - originals}장은 라벨 JSON의 좌표로 다시 그렸습니다.
      도면을 누르면 크게 보고, 공간·구조·설비 도면은 바로 평가할 수 있습니다.
    </p>
  </section>

  <main class="examples" id="examples">
    <div class="ex-toolbar">
      <div class="seg" role="group" aria-label="도면 종류">
        <button type="button" data-filter="all" aria-pressed="true">전체 <span class="mono">{examples.length}</span></button>
        {kinds.map((k) => (
          <button type="button" data-filter={k.key} aria-pressed="false">
            {k.name} <span class="mono">{countOf(k.key)}</span>
          </button>
        ))}
      </div>
      <label class="toggle">
        <input type="checkbox" id="only-original" />
        원본 이미지만
      </label>
      <p class="ex-count" id="ex-count" aria-live="polite">{examples.length}장</p>
    </div>

    {kinds.map((k) => (
      <section class="ex-group" data-group={k.key} aria-labelledby={`ex-h-${k.key}`}>
        <header class="ex-group-head">
          <div>
            <h2 id={`ex-h-${k.key}`}>
              {k.name} 도면 <span class="mono">{k.key}</span>
            </h2>
            <p>{sourceNote[k.key as keyof typeof sourceNote]}</p>
          </div>
          <ul class="ex-legend" aria-label={`${k.name} 도면 범례`}>
            {legends[k.key as keyof typeof legends].map((l) => (
              <li>
                <i style={`background:${l.fill};border-color:${l.stroke ?? l.fill}`}></i>
                {l.label}
              </li>
            ))}
          </ul>
        </header>
        <ul class="ex-grid">
          {examples
            .filter((e) => e.kind === k.key)
            .map((e) => (
              <li data-kind={e.kind} data-original={String(e.original)}>
                <a class="ex-card" href={`#${e.id}`} data-id={e.id} aria-label={`${kindName[e.kind]} 도면 ${e.number} 크게 보기`}>
                  <span class="ex-thumb">
                    <img src={`${base}${e.thumbnail}`} alt="" loading="lazy" decoding="async" />
                    <span class={`card-tag ${e.original ? 'is-original' : ''}`}>{e.original ? '원본 이미지' : '라벨로 그림'}</span>
                  </span>
                  <span class="ex-meta">
                    <span class="ex-num mono">{e.number}</span>
                    <span class="ex-sum">{summary(e)}</span>
                  </span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))}
  </main>

  <footer class="footer">
    <span>평면 평가 랩 · 예시 도면</span>
    <span>데이터: AI 허브 건축 도면 샘플 · Astro로 제작</span>
  </footer>

  <dialog class="viewer" id="viewer" aria-labelledby="viewer-title">
    <div class="viewer-bar">
      <div class="viewer-title">
        <span class="chip" id="viewer-kind"></span>
        <h2 id="viewer-title"></h2>
      </div>
      <div class="viewer-actions">
        <button type="button" class="icon-btn" data-act="prev" aria-label="이전 도면" title="이전 (←)">‹</button>
        <button type="button" class="icon-btn" data-act="next" aria-label="다음 도면" title="다음 (→)">›</button>
        <span class="viewer-sep" aria-hidden="true"></span>
        <button type="button" class="icon-btn" data-act="zoom-out" aria-label="축소" title="축소 (-)">−</button>
        <span class="zoom-level mono" id="zoom-level">100%</span>
        <button type="button" class="icon-btn" data-act="zoom-in" aria-label="확대" title="확대 (+)">+</button>
        <button type="button" class="button-ghost small" data-act="fit">맞춤</button>
        <span class="viewer-sep" aria-hidden="true"></span>
        <button type="button" class="icon-btn" data-act="close" aria-label="닫기" title="닫기 (Esc)">✕</button>
      </div>
    </div>
    <div class="viewer-body">
      <div class="viewer-stage" id="viewer-stage">
        <img id="viewer-img" alt="" draggable="false" />
        <p class="viewer-hint">휠·버튼으로 확대, 끌어서 이동</p>
      </div>
      <aside class="viewer-info" id="viewer-info"></aside>
    </div>
  </dialog>

  <script id="examples-data" type="application/json" set:html={JSON.stringify({ base, examples, legends, sourceNote, kindName })} />
  <script>
    import '../scripts/examples.js';
  </script>
</Base>
