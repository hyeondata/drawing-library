{
  "name": "drawing-library",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "node scripts/check-assets.mjs && astro build",
    "data:prepare": "python3 scripts/build.py",
    "dev": "astro dev --host 127.0.0.1 --port 8788",
    "preview": "astro preview --host 127.0.0.1 --port 8788",
    "deploy": "wrangler deploy",
    "check": "node scripts/check-assets.mjs && node --check src/scripts/viewer.js"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "astro": "^7.4.2"
  },
  "engines": { "node": ">=22.12.0" }
}
