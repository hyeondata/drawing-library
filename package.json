{
  "name": "floorplan-eval",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI 허브 아파트 평면도 기반 도면 평가 모델과 Astro 평가 서비스",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 8790",
    "build": "npm run baseline && astro build",
    "preview": "astro preview --host 127.0.0.1 --port 8790",
    "data:prepare": "python3 scripts/prepare_data.py",
    "baseline": "node scripts/build-baseline.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "npm test && npm run baseline",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.4.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.151.3"
  }
}
