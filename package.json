{
  "name": "floorplan-gen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI 허브 아파트 평면도 전체 데이터 기반 도면 생성(Astro)",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 8790",
    "build": "astro build",
    "shapes": "node scripts/build-shapes.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 8790",
    "data:prepare": "python3 scripts/prepare_data.py",
    "drawings": "node scripts/build-drawings.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "npm test && npm run drawings",
    "deploy": "wrangler deploy",
    "ocr": "node scripts/copy-ocr.mjs",
    "qubo:bench": "node scripts/qubo-benchmark.mjs --seeds 30 --budget 100",
    "stats": "node scripts/build-aihub-stats.mjs",
    "syntax": "node scripts/syntax-surrogate.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/kor": "^1.0.0",
    "astro": "^7.4.2",
    "tesseract.js": "^7.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.151.3"
  }
}
