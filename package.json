{
  "name": "floorplan-eval",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI 허브 아파트 평면도 기반 도면 평가 모델과 Astro 평가 서비스",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 8790",
    "build": "npm run baseline && node scripts/build-shapes.mjs && astro build",
    "shapes": "node scripts/build-shapes.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 8790",
    "data:prepare": "python3 scripts/prepare_data.py",
    "baseline": "node scripts/build-baseline.mjs",
    "drawings": "node scripts/build-drawings.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "npm test && npm run baseline && npm run drawings",
    "deploy": "wrangler deploy",
    "sensitivity": "node scripts/sensitivity.mjs",
    "validate": "node scripts/validate.mjs",
    "results": "node scripts/validate.mjs && node scripts/sensitivity.mjs",
    "ocr": "node scripts/copy-ocr.mjs",
    "qubo:bench": "node scripts/qubo-benchmark.mjs --seeds 30 --budget 100 && node scripts/qubo-benchmark.mjs --seeds 30 --budget 100 --hand",
    "qubo:calibrate": "node scripts/qubo-calibrate.mjs"
  },
  "dependencies": {
    "@tesseract.js-data/kor": "^1.0.0",
    "astro": "^7.4.2",
    "tesseract.js": "^7.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.151.3"
  }
}
